[
  {
    "condition": "has(hop.route) && hop.route == 'wstore'",
    "from": "./writer",
    "modifier": {
      "set_context": {
        "mem_phase": "'episode'",
        "store_origin": "'episode'"
      }
    },
    "to": "./store"
  },
  {
    "condition": "has(hop.route) && hop.route == 'astore'",
    "from": "./writer",
    "modifier": {
      "set_context": {
        "affect_req": "hop.affect_req",
        "mem_phase": "hop.phase",
        "store_origin": "'affect'"
      }
    },
    "to": "./store"
  },
  {
    "condition": "context.store_origin == 'affect'",
    "from": "./store",
    "modifier": {
      "set_context": {
        "mem_phase": "context.mem_phase"
      }
    },
    "to": "./writer"
  },
  {
    "condition": "has(hop.route) && hop.route == 'alstore'",
    "from": "./writer",
    "modifier": {
      "set_context": {
        "alias_req": "hop.alias_req",
        "mem_phase": "hop.phase",
        "store_origin": "'alias'"
      }
    },
    "to": "./store"
  },
  {
    "condition": "context.store_origin == 'alias'",
    "from": "./store",
    "modifier": {
      "set_context": {
        "mem_phase": "context.mem_phase"
      }
    },
    "to": "./writer"
  }
]
