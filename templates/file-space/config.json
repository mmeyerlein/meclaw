          "modifier": {
            "delete_context": [
              "cur_origin",
              "cur_phase",
              "cur_call",
              "cur_job"
            ]
          }
        },
        {
          "from": "./projection",
          "to": "./ws",
          "condition": "has(hop.route) && hop.route == 'in_ws'",
          "modifier": {
            "delete_context": [
              "cur_origin",
              "cur_phase",
              "cur_call",
              "cur_job"
            ]
          }
        },
        {
          "from": "./projection",
          "to": "./read",
          "condition": "has(hop.route) && hop.route == 'in_read'",
          "modifier": {
            "delete_context": [
              "cur_origin",
              "cur_phase",
              "cur_call",
              "cur_job"
            ]
          }
        },
        {
          "from": "./projection",
          "to": "./write",
          "condition": "has(hop.route) && hop.route == 'in_write'",
          "modifier": {
            "delete_context": [
              "cur_origin",
              "cur_phase",
              "cur_call",
              "cur_job"
            ]
          }
        },
        {
          "from": "./ws",
          "to": "./projection",
          "condition": "has(hop.route) && hop.route == 'answer' && has(hop.caller) && hop.caller == 'projection'",
          "modifier": {
            "set_hop": {
              "route": "'in_answer'"
            },
            "delete_context": [
              "cur_origin",
              "cur_phase",
              "cur_call",
              "cur_job"
            ]
          }
        },
        {
          "from": "./read",
          "to": "./projection",
          "condition": "has(hop.route) && hop.route == 'answer' && has(hop.caller) && hop.caller == 'projection'",
          "modifier": {
