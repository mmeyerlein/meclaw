          "from": "./derive",
          "to": ".",
          "condition": "has(hop.route) && (hop.route == 'answer' || hop.route == 'derived') && (!has(hop.caller) || hop.caller == '')",
          "modifier": {
            "delete_context": [
              "cur_origin",
              "cur_phase",
              "cur_job",
              "cur_call"
            ]
          }
        },
        {
          "from": ".",
          "to": "./projection",
          "condition": "has(hop.route) && hop.route == 'in_ws' && has(hop.op) && hop.op in ['ws_materialize', 'ws_exec', 'ws_adopt', 'ws_export_git', 'ws_import_git', 'ws_push', 'ws_pull']",
          "modifier": {
            "set_hop": {
