              "route": "'in_menu'"
            },
            "set_context": {
              "tool_answerer": "'curator'"
            }
          }
        },
        {
          "from": "./memory-hive",
          "to": "./collector",
          "condition": "!has(hop.refused_subscriber) && has(hop.route) && hop.route == 'tool_schemas'",
          "modifier": {
            "set_hop": {
              "route": "'in_menu'"
            },
            "set_context": {
              "tool_answerer": "'memory'"
            }
          }
        },
        {
          "from": "./brain",
          "to": "./splitter",
          "condition": "!(has(context.npc_kind) && context.npc_kind == 'interview') && has(hop.finish_reason) && (hop.finish_reason == 'stop' || hop.finish_reason == 'tool_calls' || hop.finish_reason == 'length')"
        },
        {
          "from": "./brain",
          "to": "./curator",
          "condition": "!(has(context.npc_kind) && context.npc_kind == 'interview') && has(hop.finish_reason) && !has(hop.refused_subscriber)",
