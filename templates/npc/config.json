          "from": "./brain",
          "to": "./world",
          "condition": "!(has(context.npc_kind) && context.npc_kind == 'interview') && has(hop.finish_reason) && (hop.finish_reason == 'error' || hop.finish_reason == 'content_filter') && !has(hop.refused_subscriber)",
