          }
        },
        {
          "from": "./collector",
          "to": "./curator",
          "condition": "has(hop.route) && hop.route == 'schemas'",
          "modifier": {
            "set_hop": {
              "route": "'in_schemas'"
            }
          }
        },
        {
          "from": "./collector",
          "to": "./memory-hive",
          "condition": "has(hop.route) && hop.route == 'schemas'",
          "modifier": {
            "set_hop": {
              "route": "'in_schemas'"
            }
          }
        },
        {
          "from": "./curator",
          "to": "./collector",
          "condition": "!has(hop.refused_subscriber) && has(hop.route) && hop.route == 'tool_schemas'",
          "modifier": {
