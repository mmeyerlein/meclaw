{
  "cell": {
    "type": "hive"
  },
  "params": {
    "ports": [],
    "required_drains": [
      {
        "accepts": "obs",
        "emits": "intent",
        "because": "a move nobody takes back leaves the world waiting for a decision that was made"
      },
      {
        "accepts": "night",
        "emits": "night",
        "because": "the receipt says the day was closed and dreamed"
      },
      {
        "accepts": "hp",
        "emits": "hp_reply",
        "because": "an answer nobody draws is a message never sent"
      },
      {
        "accepts": "interview",
        "emits": "interview",
        "because": "the asker waits for exactly this answer"
      },
      {
        "accepts": "in_model",
        "emits": "model_refused",
        "because": "a refused push is otherwise silent"
      }
    ],
    "contract": {
      "accepts": [
        {
          "route": "obs",
          "because": "a move of the world: `{turn_id, kind: plan|contact|event, text, tools[], deadline_ms?, must_say_first?, day}`. `text` is the situation as the world renders it; `tools` (at most 20, `{name, description, parameters}`) is the menu of this move and nothing else -- a call of one of them IS the move and ends it, so the move costs one model call and leaves as one `intent`. `kind` picks the instruction the turn opens with; `must_say_first` stands verbatim at its head (checking it is the world's)"
        },
        {
          "route": "night",
          "because": "the end of a game day: `{day}`. The day's session is closed by the curator, the memory reads it whole once (one model call) and the night's dream is triggered; `night` answers after the close report"
        },
        {
          "route": "digest",
          "because": "a day in summary: `{day, text}`, written as one episode -- no model call"
        },
        {
          "route": "hp",
          "because": "the character's handset: `{text, at, from}`, someone writing to the character. One round on channel `hp` in the same audience and session as the world's moves, answered on `hp_reply`"
        },
        {
          "route": "hp_reply",
          "because": "the answer to a message the character sent with `phone_call` (`{text, at, from}`): an episode now, and a line of the next move"
        },
        {
          "route": "identity",
          "because": "self facts that change in play: `{facts[], since}`. Replaces the leaf `persona.current` of the curator's pack and is written as an episode, so the close pass makes facts of it"
        },
        {
          "route": "mandate",
          "because": "a standing order of an owner: `{action: start|stop, until?, frame?, note?}`, the leaf `instructions.mandate` of the curator's pack until a `stop` replaces it"
        },
        {
          "route": "interview",
          "because": "a question from outside the play: `{question_id, question}`, answered from memory (tier 1) by one model call without tools, writing nothing; answered on `interview`"
        },
        {
          "route": "in_model",
          "because": "a model package for one model cell of this hive, pushed by the colony's llm-registry (GH #858): a params-only body the addressed `llm` cell merges into its live params. `hop.subscriber` names the cell; without one it goes to `./brain`, the one brain"
        },
        {
          "route": "mutation_committed",
          "because": "the graph moved: the collector asks the curator and the memory for their tools again"
        }
      ],
      "emits": [
        {
          "route": "intent",
          "because": "the decision of a move: `{turn_id, intents: [{tool, args, says?}]}`, `turn_id` as the `obs` brought it; `{turn_id, intents: []}` for a move that called no tool, `{turn_id, never: true}` for a move whose model call failed"
        },
        {
          "route": "night",
          "because": "the receipt of a night: `{day, ok, added, closed}` after the memory's close report (`ok` false when the close pass was refused)"
        },
        {
          "route": "hp",
          "because": "a message the character sends with its `phone_call` tool: `{text, to, at, from}`"
        },
        {
          "route": "hp_reply",
          "because": "the character's answer to an `hp` message: `{text, to, at, from}`"
        },
        {
          "route": "interview",
          "because": "the answer to an `interview`: `{question_id, answer}`"
        },
        {
          "route": "model_refused",
          "because": "a model package pushed through `in_model` that a model cell refused (GH #863)"
        },
        {
          "route": "error",
          "because": "a failed round (`{error_code, turn_id, kind}`) or a failure of `./access`; never silent"
        }
      ]
    },
    "graph": {
      "edges": [
        {
          "from": ".",
          "to": "./world",
          "condition": "has(hop.route) && hop.route == 'obs' && !has(hop.npc_rim)"
        },
        {
          "from": ".",
          "to": "./world",
          "condition": "has(hop.route) && hop.route == 'night' && !has(hop.npc_rim)"
        },
        {
          "from": ".",
          "to": "./world",
          "condition": "has(hop.route) && hop.route == 'digest' && !has(hop.npc_rim)"
        },
        {
          "from": ".",
          "to": "./world",
          "condition": "has(hop.route) && hop.route == 'hp' && !has(hop.npc_rim)"
        },
        {
          "from": ".",
          "to": "./world",
          "condition": "has(hop.route) && hop.route == 'hp_reply' && !has(hop.npc_rim)"
        },
        {
          "from": ".",
          "to": "./world",
          "condition": "has(hop.route) && hop.route == 'identity' && !has(hop.npc_rim)"
        },
        {
          "from": ".",
          "to": "./world",
          "condition": "has(hop.route) && hop.route == 'mandate' && !has(hop.npc_rim)"
        },
        {
          "from": ".",
          "to": "./world",
          "condition": "has(hop.route) && hop.route == 'interview' && !has(hop.npc_rim)"
        },
        {
          "from": "./world",
          "to": ".",
          "condition": "has(hop.route) && hop.route == 'intent' && has(hop.npc_rim) && hop.npc_rim == 'out'",
          "modifier": {
            "set_hop": {
              "route": "'intent'"
            },
            "delete_context": [
              "col_phase",
              "curator_call",
              "tool_answerer",
              "recall_input_soft",
              "input_soft",
              "gap_ask",
              "npc_at",
              "npc_day",
              "npc_from",
              "npc_kind",
              "npc_origin",
              "npc_turn"
            ]
          }
        },
        {
          "from": "./world",
          "to": ".",
          "condition": "has(hop.route) && hop.route == 'night' && has(hop.npc_rim) && hop.npc_rim == 'out'",
          "modifier": {
            "set_hop": {
              "route": "'night'"
            },
            "delete_context": [
              "col_phase",
              "curator_call",
              "tool_answerer",
              "recall_input_soft",
              "input_soft",
              "gap_ask",
              "npc_at",
              "npc_day",
              "npc_from",
              "npc_kind",
              "npc_origin",
              "npc_turn"
            ]
          }
        },
        {
          "from": "./world",
          "to": ".",
          "condition": "has(hop.route) && hop.route == 'hp' && has(hop.npc_rim) && hop.npc_rim == 'out'",
          "modifier": {
            "set_hop": {
              "route": "'hp'"
            },
            "delete_context": [
              "col_phase",
              "curator_call",
              "tool_answerer",
              "recall_input_soft",
              "input_soft",
              "gap_ask",
              "npc_at",
              "npc_day",
              "npc_from",
              "npc_kind",
              "npc_origin",
              "npc_turn"
            ]
          }
        },
        {
          "from": "./world",
          "to": ".",
          "condition": "has(hop.route) && hop.route == 'hp_reply' && has(hop.npc_rim) && hop.npc_rim == 'out'",
          "modifier": {
            "set_hop": {
              "route": "'hp_reply'"
            },
            "delete_context": [
              "col_phase",
              "curator_call",
              "tool_answerer",
              "recall_input_soft",
              "input_soft",
              "gap_ask",
              "npc_at",
              "npc_day",
              "npc_from",
              "npc_kind",
              "npc_origin",
              "npc_turn"
            ]
          }
        },
        {
          "from": "./world",
          "to": ".",
          "condition": "has(hop.route) && hop.route == 'interview' && has(hop.npc_rim) && hop.npc_rim == 'out'",
          "modifier": {
            "set_hop": {
              "route": "'interview'"
            },
            "delete_context": [
              "col_phase",
              "curator_call",
              "tool_answerer",
              "recall_input_soft",
              "input_soft",
              "gap_ask",
              "npc_at",
              "npc_day",
              "npc_from",
              "npc_kind",
              "npc_origin",
              "npc_turn"
            ]
          }
        },
        {
          "from": "./world",
          "to": ".",
          "condition": "has(hop.route) && hop.route == 'error' && has(hop.npc_rim) && hop.npc_rim == 'out'",
          "modifier": {
            "set_hop": {
              "route": "'error'"
            },
            "delete_context": [
              "col_phase",
              "curator_call",
              "tool_answerer",
              "recall_input_soft",
              "input_soft",
              "gap_ask",
              "npc_at",
              "npc_day",
              "npc_from",
              "npc_kind",
              "npc_origin",
              "npc_turn"
            ]
          }
        },
        {
          "from": ".",
          "to": "./collector",
          "condition": "has(hop.route) && hop.route == 'mutation_committed'"
        },
        {
          "from": ".",
          "to": "./brain",
          "condition": "has(hop.route) && hop.route == 'in_model' && !(has(hop.subscriber) && (hop.subscriber.endsWith('/curator/summarizer') || hop.subscriber.contains('/memory-hive/')))"
        },
        {
          "from": ".",
          "to": "./curator",
          "condition": "has(hop.route) && hop.route == 'in_model' && has(hop.subscriber) && hop.subscriber.endsWith('/curator/summarizer')"
        },
        {
          "from": ".",
          "to": "./memory-hive",
          "condition": "has(hop.route) && hop.route == 'in_model' && has(hop.subscriber) && hop.subscriber.contains('/memory-hive/')"
        },
        {
          "from": "./world",
          "to": "./collector",
          "condition": "has(hop.route) && hop.route == 'in_turn'",
          "modifier": {
            "set_context": {
              "session_id": "hop.session_id",
              "turn_id": "hop.turn_id",
              "channel": "hop.channel",
              "audience_set": "hop.audience_set",
              "npc_turn": "hop.turn_id",
              "npc_kind": "hop.npc_kind",
              "npc_day": "hop.npc_day",
              "npc_origin": "'world'",
              "npc_from": "has(hop.npc_from) ? hop.npc_from : ''",
              "npc_at": "has(hop.npc_at) ? hop.npc_at : ''"
            },
            "restore_ttl": true
          }
        },
        {
          "from": "./world",
          "to": "./collector",
          "condition": "has(hop.route) && hop.route == 'in_menu'",
          "modifier": {
            "set_context": {
              "tool_answerer": "'world'"
            }
          }
        },
        {
          "from": "./world",
          "to": "./collector",
          "condition": "has(hop.route) && hop.route == 'in_calls'"
        },
        {
          "from": "./world",
          "to": "./curator",
          "condition": "has(hop.route) && hop.route == 'in_pack'"
        },
        {
          "from": "./world",
          "to": "./curator",
          "condition": "has(hop.route) && hop.route == 'in_close'",
          "modifier": {
            "set_context": {
              "session_id": "hop.session_id",
              "channel": "hop.channel",
              "audience_set": "hop.audience_set",
              "npc_kind": "hop.npc_kind",
              "npc_day": "hop.npc_day"
            },
            "restore_ttl": true
          }
        },
        {
          "from": "./world",
          "to": "./memory-hive",
          "condition": "has(hop.route) && hop.route == 'in_episode'",
          "modifier": {
            "set_context": {
              "session_id": "hop.session_id",
              "turn_id": "hop.turn_id",
              "channel": "hop.channel",
              "audience_set": "hop.audience_set",
              "happened_at": "has(hop.happened_at) ? hop.happened_at : ''"
            }
          }
        },
        {
          "from": "./world",
          "to": "./memory-hive",
          "condition": "has(hop.route) && hop.route == 'in_query'",
          "modifier": {
            "set_context": {
              "recall_query": "hop.recall_query",
              "memory_tier": "hop.memory_tier",
              "recall_as_of": "''",
              "recall_window_from": "''",
              "recall_window_to": "''",
              "recall_input_soft": "''",
              "audience_now": "hop.audience_set",
              "channel": "hop.channel",
              "session_id": "hop.session_id",
              "recall_caller": "hop.recall_caller",
              "npc_kind": "'interview'"
            }
          }
        },
        {
          "from": "./world",
          "to": "./memory-hive",
          "condition": "has(hop.route) && hop.route == 'clock_op'"
        },
        {
          "from": "./world",
          "to": "./brain",
          "condition": "has(hop.route) && hop.route == 'brain'",
          "modifier": {
            "set_context": {
              "turn_id": "hop.turn_id",
              "npc_kind": "hop.npc_kind",
              "npc_origin": "'world'"
            },
            "restore_ttl": true
          }
        },
        {
          "from": "./collector",
          "to": "./curator",
          "condition": "has(hop.route) && hop.route == 'curate' && has(hop.iter) && int(hop.iter) < 20",
          "modifier": {
            "set_hop": {
              "route": "'in_curate'"
            },
            "restore_ttl": true
          }
        },
        {
          "from": "./curator",
          "to": "./brain",
          "condition": "!has(hop.refused_subscriber) && has(hop.route) && hop.route == 'brain' && has(hop.iter) && int(hop.iter) < 20",
          "modifier": {
            "set_context": {
              "curator_call": "hop.curator_call",
              "turn_id": "hop.turn_id",
              "session_id": "hop.session_id",
              "iter": "hop.iter",
              "recall_input_soft": "has(hop.recall_input_soft) ? hop.recall_input_soft : ''"
            },
            "restore_ttl": true
          }
        },
        {
          "from": "./collector",
          "to": "./curator",
          "condition": "has(hop.route) && hop.route == 'menu'",
          "modifier": {
