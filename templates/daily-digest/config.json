{
  "cell": {
    "type": "hive"
  },
  "params": {
    "ports": [],
    "contract": {
      "accepts": [
        {
          "route": "in_digest",
          "context": [
            "chat_id"
          ],
          "because": "a digest run demanded NOW, outside the timer: the same body the schedule emits -- one `tool_call` turn whose text is the JSON arguments carrying the URL. `chat_id` must be promoted to context by the caller (a string, as the timer's own header is), because the formatter recasts it into the delivery header and cannot invent one"
        },
        {
          "route": "in_read",
          "because": "a read of the last digests (GH #976, the residents' road of GH #965): hop `op` = `last`, `op_id` mirrored. Answered by exactly one `answer` `{ok, op, digests: [{id, at, when, title, items, lead, audience_set}]}`, newest first, holding only the digests whose round covers the round of the read (`context.audience_set`, the builder's word) -- or `{ok: false, error: {code: unknown_op | no_round | store_error}}`. A read without a round reads no row"
        },
        {
          "route": "in_params",
          "because": "a params-only update for one cell of this hive or of a sealed hive in it (GH #1353): `hop.subscriber` is the cell's absolute path, the body carries `params` and nothing else. The inner edges carry it to that cell by the end of the path; a cell of another path applies nothing. Answered by exactly one `params_applied` or `params_refused`. Draw it only from the operator's road"
        }
      ],
      "emits": [
        {
          "route": "digest",
          "because": "the formatted digest of a run that was demanded from outside, handed back to whoever demanded it instead of being pushed into this bot's own chat. A scheduled run goes to the notifier and never reaches this lane"
        },
        {
          "route": "answer",
          "because": "the one answer to an `in_read`, with the asker's context, so the edge that asked can take it back; `op` and `op_id` mirrored, every digest with the round it was made for"
        },
        {
          "route": "error",
          "because": "a failure of `./access`, the broker that hands this template's cells their credentials sealed (GH #801): a refused or failed credential round. Which cell inside produced it is not the caller's business; a parent that drains nothing loses every refusal"
        },
        {
          "route": "params_applied",
          "because": "the cell named by `hop.subscriber` of an `in_params` update merged it into its live params (GH #1353)"
        },
        {
          "route": "params_refused",
          "because": "the cell named by `hop.subscriber` of an `in_params` update refused it whole: `hop.refused_subscriber` is its path, `hop.error_code` the code and the body the detail (GH #1353)"
        }
      ]
    },
    "graph": {
      "edges": [
        {
          "from": ".",
          "to": "./fetcher",
          "condition": "has(hop.route) && hop.route == 'in_digest'",
          "modifier": {
            "set_context": {
              "digest_origin": "'parent'",
              "digest_round": "has(context.audience_set) ? context.audience_set : ''"
            },
            "delete_context": [
              "shelf_origin",
              "shelf_op_id"
            ]
          }
        },
        {
          "from": "./clock",
          "to": "./fetcher",
          "condition": "has(hop.schedule_name) && hop.schedule_name == 'daily-digest'",
          "modifier": {
            "set_context": {
              "chat_id": "hop.chat_id",
              "digest_origin": "'schedule'"
            }
          }
        },
        {
          "from": "./fetcher",
          "to": "./format",
          "condition": "has(hop.http_status) && hop.http_status >= 200 && hop.http_status < 300"
        },
        {
          "from": "./format",
          "to": "./notifier",
          "condition": "(!has(context.digest_origin) || context.digest_origin != 'parent')",
          "modifier": {
            "set_context": {
              "chat_id": "hop.chat_id"
            }
          }
        },
        {
          "from": "./format",
          "to": ".",
          "condition": "has(context.digest_origin) && context.digest_origin == 'parent'",
          "modifier": {
            "set_hop": {
              "route": "'digest'"
            },
            "delete_context": [
              "digest_origin",
              "digest_round",
              "shelf_op_id",
              "shelf_origin"
            ]
          }
        },
        {
          "from": "./void",
          "to": "./format"
        },
        {
          "from": "./format",
          "to": "./shelf"
        },
        {
          "from": "./shelf",
          "to": "./store",
          "condition": "has(hop.route) && hop.route == 'shelf_store'"
        },
        {
          "from": "./store",
          "to": "./shelf",
          "condition": "!has(hop.params_answer)"
        },
        {
          "from": ".",
          "to": "./shelf",
          "condition": "has(hop.route) && hop.route == 'in_read' && !has(hop.error_code)",
          "modifier": {
            "set_context": {
              "shelf_origin": "'read'",
              "shelf_op_id": "has(hop.op_id) ? hop.op_id : ''"
            }
          }
        },
        {
          "from": "./shelf",
          "to": ".",
          "condition": "has(hop.route) && hop.route == 'answer'",
          "modifier": {
            "set_hop": {
              "op_id": "has(context.shelf_op_id) ? context.shelf_op_id : ''"
            },
            "delete_context": [
              "shelf_op_id",
              "shelf_origin",
              "digest_origin",
              "digest_round"
            ]
          }
        },
        {
          "from": "./notifier",
          "to": "./access",
          "condition": "has(hop.route) && hop.route == 'credential_request'",
          "modifier": {
            "set_hop": {
              "route": "'in_invoke'"
            },
            "set_context": {
              "requester": "'agent:daily-digest/notifier'"
            }
          }
        },
        {
          "from": "./access",
          "to": "./notifier",
          "condition": "has(hop.route) && hop.route == 'ack' && has(hop.operation) && hop.operation == 'vault.deliver' && has(hop.grant_id) && hop.grant_id == 'grant:telegram-bot@template-daily-digest/notifier'",
          "modifier": {
            "set_hop": {
              "route": "'in_sealed'"
            }
          }
        },
        {
          "from": "./access",
          "to": ".",
          "condition": "has(hop.route) && hop.route == 'error'",
          "modifier": {
            "delete_context": [
              "digest_origin",
              "digest_round",
              "shelf_op_id",
              "shelf_origin"
            ]
          }
        },
        {
          "from": ".",
          "to": "./access",
          "condition": "has(hop.route) && hop.route == 'in_params' && has(hop.subscriber) && hop.subscriber.matches('/access/[^/]+$')"
        },
        {
          "from": ".",
          "to": "./clock",
          "condition": "has(hop.route) && hop.route == 'in_params' && has(hop.subscriber) && hop.subscriber.endsWith('/clock') && !hop.subscriber.endsWith('/access/clock')"
        },
        {
          "from": ".",
          "to": "./notifier",
          "condition": "has(hop.route) && hop.route == 'in_params' && has(hop.subscriber) && hop.subscriber.endsWith('/notifier')"
        },
        {
          "from": ".",
          "to": "./store",
          "condition": "has(hop.route) && hop.route == 'in_params' && has(hop.subscriber) && hop.subscriber.endsWith('/store') && !hop.subscriber.endsWith('/access/store')"
        },
        {
          "from": "./access",
          "to": ".",
          "condition": "has(hop.route) && (hop.route == 'params_applied' || hop.route == 'params_refused')",
          "modifier": {
            "delete_context": [
              "digest_origin",
              "digest_round",
              "shelf_op_id",
              "shelf_origin"
            ]
          }
        },
        {
          "from": "./clock",
          "to": ".",
          "condition": "has(hop.params_answer) && hop.params_answer == 'params_applied'",
          "modifier": {
            "set_hop": {
              "route": "'params_applied'"
            },
            "delete_context": [
              "digest_origin",
              "digest_round",
              "shelf_op_id",
              "shelf_origin"
            ]
          }
        },
        {
          "from": "./clock",
          "to": ".",
          "condition": "has(hop.params_answer) && hop.params_answer == 'params_refused'",
          "modifier": {
            "set_hop": {
              "route": "'params_refused'"
            },
            "delete_context": [
              "digest_origin",
              "digest_round",
              "shelf_op_id",
              "shelf_origin"
            ]
          }
        },
        {
          "from": "./notifier",
          "to": ".",
          "condition": "has(hop.params_answer) && hop.params_answer == 'params_applied'",
          "modifier": {
            "set_hop": {
              "route": "'params_applied'"
            },
            "delete_context": [
              "digest_origin",
              "digest_round",
              "shelf_op_id",
              "shelf_origin"
            ]
          }
        },
        {
          "from": "./notifier",
          "to": ".",
          "condition": "has(hop.params_answer) && hop.params_answer == 'params_refused'",
          "modifier": {
            "set_hop": {
              "route": "'params_refused'"
            },
            "delete_context": [
              "digest_origin",
              "digest_round",
              "shelf_op_id",
              "shelf_origin"
            ]
          }
        },
        {
          "from": "./store",
          "to": ".",
          "condition": "has(hop.params_answer) && hop.params_answer == 'params_applied'",
          "modifier": {
            "set_hop": {
              "route": "'params_applied'"
            },
            "delete_context": [
              "digest_origin",
              "digest_round",
              "shelf_op_id",
              "shelf_origin"
            ]
          }
        },
        {
          "from": "./store",
          "to": ".",
          "condition": "has(hop.params_answer) && hop.params_answer == 'params_refused'",
          "modifier": {
            "set_hop": {
              "route": "'params_refused'"
            },
            "delete_context": [
              "digest_origin",
              "digest_round",
              "shelf_op_id",
              "shelf_origin"
            ]
          }
        }
      ]
    }
  },
  "description": {
    "purpose": "Composes timer, web_fetch, formatter and Telegram proxy into a linear scheduled push pipeline.",
    "use_when": "Daily one-URL digest to one chat, or a run demanded from outside on lane in_digest. Non-2xx fetches have no edge -- they dead-letter (wire a failure branch if you need alerting).",
    "not_in_scope": "No retries, no aggregation, no summarization.",
    "examples": [
      "clock -> fetcher -> format -> notifier. chat_id travels: timer emit_headers (string) -> context on edge 1 -> recast to number by format -> context on edge 3. A run demanded at the hive path on lane in_digest enters at the fetcher with context.digest_origin 'parent' and its formatted digest leaves at the hive path on lane digest instead of going to the notifier; the caller brings context.chat_id itself."
    ]
  }
}
