{
  "cell": {
    "type": "hive"
  },
  "params": {
    "ports": [],
    "contract": {
      "accepts": [
        {
          "route": "in_episode",
          "because": "one conversational turn, or a closed session batch, to be remembered verbatim; `session_id` and `turn_id` travel as ingress context, `happened_at` on the hop for historical ingest"
        },
        {
          "route": "in_query",
          "because": "a question against this memory. The five recall keys (recall_query, memory_tier, recall_as_of, recall_window_from, recall_window_to) come as context, always all five, empty string = unset"
        },
        {
          "route": "in_remember",
          "because": "a block the front model decided to remember NOW, in the inline contract form; it is bound to the newest user turn of the caller session, so the session must be in the context"
        },
        {
          "route": "in_flush",
          "because": "drain the extraction queue now, whatever the batch gate would say; add `flush_reclaim` on the hop to also recover batches whose chain died"
        }
      ],
      "emits": [
        {
          "route": "bundle",
          "because": "the answer to a question: the recalled material, fused and ranked, for whoever asked"
        },
        {
          "route": "reject",
          "because": "something this hive was sent and would not take -- a block it cannot bind, a half window it will not guess at. The body says which and why. Drain it: undrained, nobody ever learns the memory was not written and the caller waits for a bundle that never comes"
        }
      ]
    },
    "graph": {
      "edges": [
        {
          "from": ".",
          "to": "./writer",
          "condition": "has(hop.route) && hop.route == 'in_episode'"
        },
        {
          "from": ".",
          "to": "./recall",
          "condition": "has(hop.route) && hop.route == 'in_query'",
          "modifier": {
            "set_hop": {
              "phase": "'recall'"
            }
          }
        },
        {
          "from": ".",
          "to": "./extract-glue",
          "condition": "has(hop.route) && hop.route == 'in_remember'",
          "modifier": {
            "set_context": {
              "store_origin": "'inline'",
              "mem_phase": "'inline'"
            }
          }
        },
        {
          "from": ".",
          "to": "./extract-glue",
          "condition": "has(hop.route) && hop.route == 'in_flush'",
          "modifier": {
            "set_context": {
              "mem_phase": "'flush'"
            }
          }
        },
        {
          "from": "./writer",
          "to": "./store",
          "condition": "has(hop.route) && hop.route == 'wstore'",
          "modifier": {
            "set_context": {
              "store_origin": "'episode'",
              "mem_phase": "'episode'"
            }
          }
        },
        {
          "from": "./recall",
          "to": "./store",
          "condition": "has(hop.route) && hop.route == 'rstore'",
          "modifier": {
            "set_context": {
              "store_origin": "'recall'",
              "mem_phase": "hop.phase",
              "recall_id": "hop.recall_id"
            }
          }
        },
        {
          "from": "./store",
          "to": "./recall",
          "condition": "context.store_origin == 'recall'",
          "modifier": {
            "set_context": {
              "mem_phase": "context.mem_phase"
            }
          }
        },
        {
          "from": "./writer",
          "to": "./extract-glue",
          "condition": "has(hop.route) && hop.route == 'enqueue'",
          "modifier": {
            "set_context": {
              "store_origin": "'extract'",
              "mem_phase": "'enqueue'"
            }
          }
        },
        {
          "from": "./store",
          "to": "./extract-glue",
          "condition": "context.store_origin == 'episode'",
          "modifier": {
            "set_context": {
              "mem_phase": "'episode'"
            }
          }
        },
        {
          "from": "./store",
          "to": "./extract-glue",
          "condition": "context.store_origin == 'extract'",
          "modifier": {
            "set_context": {
              "mem_phase": "context.mem_phase",
              "batch_id": "context.batch_id"
            }
          }
        },
        {
          "from": "./extract-glue",
          "to": "./store",
          "condition": "has(hop.route) && hop.route == 'xstore'",
          "modifier": {
            "set_context": {
              "store_origin": "'extract'",
              "mem_phase": "hop.phase",
              "batch_id": "hop.batch_id"
            }
          }
        },
        {
          "from": "./extract-glue",
          "to": "./extractor",
          "condition": "has(hop.route) && hop.route == 'extract'"
        },
        {
          "from": "./extractor",
          "to": "./extract-glue",
          "modifier": {
            "set_context": {
              "store_origin": "'extract'",
              "mem_phase": "'parse'"
            }
          }
        },
        {
          "from": "./cron",
          "to": "./dream-glue",
          "condition": "has(hop.schedule_name) && hop.schedule_name == 'nightly-dream'",
          "modifier": {
            "set_context": {
              "dream_run": "hop.event_id",
              "dream_to": "hop.fired_at",
              "store_origin": "'dream'",
              "mem_phase": "'window'"
            }
          }
        },
        {
          "from": "./dream-glue",
          "to": "./store",
          "condition": "has(hop.route) && hop.route == 'dstore'",
          "modifier": {
            "set_context": {
              "store_origin": "'dream'",
              "mem_phase": "hop.phase",
              "dream_run": "hop.dream_run",
              "dream_to": "hop.dream_to"
            }
          }
        },
        {
          "from": "./store",
          "to": "./dream-glue",
          "condition": "context.store_origin == 'dream'",
          "modifier": {
            "set_context": {
              "mem_phase": "context.mem_phase"
            }
          }
        },
        {
          "from": "./dream-glue",
          "to": "./dreamer",
          "condition": "has(hop.route) && hop.route == 'dream'"
        },
        {
          "from": "./dreamer",
          "to": "./dream-glue",
          "modifier": {
            "set_context": {
              "store_origin": "'dream'",
              "mem_phase": "'verdict'"
            }
          }
        },
        {
          "from": "./dream-glue",
          "to": "./judge",
          "condition": "has(hop.route) && hop.route == 'judge'"
        },
        {
          "from": "./judge",
          "to": "./dream-glue",
          "modifier": {
            "set_context": {
              "store_origin": "'dream'",
              "mem_phase": "'canon-judged'"
            }
          }
        },
        {
          "from": "./extract-glue",
          "to": "./embed",
          "condition": "has(hop.route) && hop.route == 'embed'",
          "modifier": {
            "set_context": {
              "mem_phase": "'embed'"
            }
          }
        },
        {
          "from": "./dream-glue",
          "to": "./embed",
          "condition": "has(hop.route) && hop.route == 'embed'",
          "modifier": {
            "set_context": {
              "mem_phase": "'embed'"
            }
          }
        },
        {
          "from": "./embed",
          "to": "./store",
          "condition": "has(hop.route) && hop.route == 'estore'",
          "modifier": {
            "set_context": {
              "store_origin": "'embed'",
              "mem_phase": "'embedded'"
            }
          }
        },
        {
          "from": "./store",
          "to": "./embed",
          "condition": "context.store_origin == 'embed'",
          "modifier": {
            "set_context": {
              "mem_phase": "'embed-done'"
            }
          }
        },
        {
          "from": "./recall",
          "to": "./embed",
          "condition": "has(hop.route) && hop.route == 'embed'",
          "modifier": {
            "set_context": {
              "mem_phase": "'embed-query'",
              "recall_id": "hop.recall_id",
              "store_origin": "'recall'"
            }
          }
        },
        {
          "from": "./embed",
          "to": "./recall",
          "condition": "has(hop.route) && hop.route == 'equery'",
          "modifier": {
            "set_context": {
              "mem_phase": "'t1-qvec'"
            }
          }
        },
        {
          "from": "./recall",
          "to": "./dialectic",
          "condition": "has(hop.route) && hop.route == 'dialectic'",
          "modifier": {
            "set_context": {
              "mem_phase": "'dialectic'",
              "recall_id": "hop.recall_id"
            }
          }
        },
        {
          "from": "./dialectic",
          "to": "./recall",
          "modifier": {
            "set_context": {
              "mem_phase": "'answer'"
            }
          }
        },
        {
          "from": "./recall",
          "to": ".",
          "condition": "has(hop.route) && hop.route == 'bundle'"
        },
        {
          "from": "./recall",
          "to": ".",
          "condition": "has(hop.route) && hop.route == 'reject'"
        },
        {
          "from": "./extract-glue",
          "to": ".",
          "condition": "has(hop.route) && hop.route == 'reject'"
        }
      ]
    }
  },
  "description": {
    "purpose": "Scope marker of the memory hive: bundles the durable store and the write/recall/extraction/consolidation lanes of one agent's memory behind ITS OWN PATH. `params.ports` is empty, so no edge reaches a cell in here; a caller names the hive and a lane on `hop.route`. The consolidation lane carries two model roles: the dreamer writes the change narrative, the judge decides identity for the nightly canonicalisation round.",
    "use_when": "Instantiate per agent tree; wire the lanes at the hive path in the same mutation.",
    "not_in_scope": "No agent logic, no conversation state, no routing for the parent scope — the hive only carries its internal graph.",
    "contract_in": "Four lanes, all at the hive path. in_episode -- remember this turn. in_query -- answer this question. in_remember -- take this block now (inline). in_flush -- drain the extraction queue now. Which cell serves a lane is this hive's business.",
    "contract_out": "Two lanes, out of the hive path. bundle -- the answer to a question. reject -- something this hive would not take; the body says which and why."
  }
}
