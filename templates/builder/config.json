{
  "cell": {
    "type": "hive"
  },
  "params": {
    "ports": [],
    "contract": {
      "accepts": [
        {
          "route": "in_build",
          "context": [],
          "because": "a structural wish to draft a manifest for. It carries NO promoted identity, and that is a decision rather than an omission: this hive never emits a mutation, so it has nothing to attribute. Identity is read exactly once, at the submitter, off `envelope.reply_to` where the substrate stamped it -- and an edge modifier cannot reach the envelope, so a `context.requester` demanded here could only ever be filled with a constant somebody wrote down. A claim is not an identity, and one place that can verify it beats two that cannot."
        },
        {
          "route": "in_receipt",
          "context": [],
          "because": "a refusal the submitter took at the door, on its way back to the composer that wrote the draft. It carries no identity either, for the same reason `in_build` does not: this hive still emits no mutation. What it carries is an error_code, and NAMING it is the whole of the lane -- a refusal the model cannot name is one it cannot repair. The repair budget is separate from the round budget and lives on the edge that spends it."
        },
        {
          "route": "in_ingest",
          "context": [],
          "because": "a nudge to reconcile the corpus behind this hive against the colony's own template registry, forwarded to the librarian and read by nothing here. The corpus is a SEED: it describes the library of the moment the librarian was born, so a class registered since -- an `add_templates`, a directory dropped in plus a rescan -- is resolvable at the mutation door and invisible to the composer. The lane is a TRANSIT lane and that is the whole of its design: the mechanism lives one storey down (GH #496) and was unreachable, because the only cell in a tree that knows a submission committed AND that its diff registered a class sits outside this hive, and an edge from there to a cell INSIDE it crosses two seals. A lane at the hive path is the one form both ends can draw"
        }
      ],
      "emits": [
        {
          "route": "manifest",
          "because": "the draft -- an ordered list of mutation declarations plus the sha256 digest over it and a sentence a human can read before saying yes. It is a PROPOSAL: nothing here has applied it and nothing here can"
        },
        {
          "route": "error",
          "because": "a wish this hive did not turn into a manifest, named. Drafting is not an enhancement that may degrade quietly: a build that stops must say so on a lane, never as silence and never as an empty manifest"
        },
        {
          "route": "catalogue",
          "because": "the reconciliation's own report, on its way back out: how many templates the registry holds, how many the corpus already carried, how many rows were written and which names. It leaves because a report nobody can subscribe to is a dead letter -- measured as one, twice, in a built colony -- and because a caller that drives `in_ingest` and is told nothing cannot tell a corpus that was already current from a nudge that never ran"
        }
      ]
    },
    "required_drains": [
      {
        "accepts": "in_build",
        "emits": "manifest",
        "because": "a caller that sends a wish in and does not take the draft back has started a round that answers into nothing. The two edges are one decision"
      },
      {
        "accepts": "in_ingest",
        "emits": "catalogue",
        "because": "a caller that nudges this hive and does not take the report back has asked the corpus to change and arranged to never learn whether it did. The counts are the only difference between 'nothing was missing' and 'nothing happened', and those two facts must never look alike. The two edges are one decision"
      }
    ],
    "graph": {
      "edges": [
        {
          "from": ".",
          "to": "./classify",
          "condition": "has(hop.route) && hop.route == 'in_build'"
        },
        {
          "from": "./classify",
          "to": "./recipes",
          "condition": "has(hop.route) && hop.route == 'recipe'"
        },
        {
          "from": "./classify",
          "to": "./tally",
          "condition": "has(hop.route) && hop.route == 'count'"
        },
        {
          "from": "./tally",
          "to": "./transcript",
          "condition": "has(hop.route) && hop.route == 'cstore'",
          "modifier": {
            "set_context": {
              "store_origin": "'tally'",
              "tally_tag": "hop.tally_tag",
              "member_index": "hop.member_index"
            }
          }
        },
        {
          "from": "./transcript",
          "to": "./tally",
          "condition": "context.store_origin == 'tally'"
        },
        {
          "from": "./tally",
          "to": "/colony/graph",
          "condition": "has(hop.route) && hop.route == 'graph'"
        },
        {
          "from": "./tally",
          "to": "./recipes",
          "condition": "has(hop.route) && hop.route == 'recipe'",
          "modifier": {
            "set_context": {
              "build_call_id": "hop.build_call_id",
              "agent": "hop.agent",
              "build_op": "hop.build_op",
              "build_scope": "hop.build_scope",
              "build_caller": "hop.build_caller",
              "build_auto_submit": "hop.build_auto_submit"
            },
            "delete_context": [
              "store_origin",
              "tally_tag",
              "member_index"
            ]
          }
        },
        {
          "from": "./tally",
          "to": ".",
          "condition": "has(hop.operation) && hop.operation == 'tally' && has(hop.error_code)",
          "modifier": {
            "set_hop": {
              "route": "'error'"
            },
            "delete_context": [
              "agent",
              "build_id",
              "build_op",
              "build_scope",
              "lib_call_id",
              "member_index",
              "repairs",
              "store_origin",
              "tally_tag"
            ]
          }
        },
        {
          "from": "./classify",
          "to": "./brief",
          "condition": "has(hop.route) && hop.route == 'design'",
          "modifier": {
            "set_context": {
              "build_scope": "hop.build_scope"
            }
          }
        },
        {
          "from": "./brief",
          "to": "./transcript",
          "condition": "has(hop.route) && hop.route == 'cstore'",
          "modifier": {
            "set_context": {
              "store_origin": "'weave'"
            }
          }
        },
        {
          "from": "./brief",
          "to": "./compose",
          "condition": "has(hop.route) && hop.route == 'compose'",
          "modifier": {
            "set_context": {
              "build_id": "hop.build_id",
              "iter": "'0'",
              "repairs": "'0'"
            }
          }
        },
        {
          "from": "./compose",
          "to": "./dispatcher",
          "condition": "has(hop.finish_reason) && hop.finish_reason == 'tool_calls'"
        },
        {
          "from": "./compose",
          "to": "./normalise",
          "condition": "has(hop.finish_reason) && (hop.finish_reason == 'stop' || hop.finish_reason == 'length')"
        },
        {
          "from": "./compose",
          "to": ".",
          "condition": "has(hop.finish_reason) && (hop.finish_reason == 'error' || hop.finish_reason == 'content_filter')",
          "modifier": {
            "set_hop": {
              "route": "'error'",
              "error_code": "'composer_failed'"
            },
            "delete_context": [
              "agent",
              "build_id",
              "build_op",
              "build_scope",
              "lib_call_id",
              "member_index",
              "repairs",
              "store_origin",
              "tally_tag"
            ]
          }
        },
        {
          "from": "./dispatcher",
          "to": "./weave",
          "condition": "has(hop.route) && hop.route == 'calls'"
        },
        {
          "from": "./dispatcher",
          "to": "./weave",
          "condition": "has(hop.route) && hop.route == 'answer'"
        },
        {
          "from": "./dispatcher",
          "to": "./lib",
          "condition": "has(hop.tool_name) && (hop.tool_name == 'librarian_search' || hop.tool_name == 'catalogue_lookup')"
        },
        {
          "from": "./dispatcher",
          "to": "./eyes",
          "condition": "has(hop.tool_name) && (hop.tool_name == 'graph_read' || hop.tool_name == 'registry_read')"
        },
        {
          "from": "./dispatcher",
          "to": "./unknown",
          "default": true,
          "condition": "has(hop.route) && hop.route == 'tool'"
        },
        {
          "from": "./dispatcher",
          "to": "./weave",
          "condition": "has(hop.route) && hop.route == 'result'"
        },
        {
          "from": "./lib",
          "to": "./builder-librarian",
          "condition": "has(hop.route) && hop.route == 'lsearch_out'",
          "modifier": {
            "set_hop": {
              "route": "'in_request'"
            },
            "set_context": {
              "lib_call_id": "hop.lib_call_id"
            }
          }
        },
        {
          "from": "./builder-librarian",
          "to": "./lib",
          "condition": "has(hop.route) && hop.route == 'brief'"
        },
        {
          "from": ".",
          "to": "./builder-librarian",
          "condition": "has(hop.route) && hop.route == 'in_ingest'"
        },
        {
          "from": "./builder-librarian",
          "to": ".",
          "condition": "has(hop.route) && hop.route == 'catalogue'",
          "modifier": {
            "delete_context": [
              "agent",
              "build_id",
              "build_op",
              "build_scope",
              "lib_call_id",
              "member_index",
              "repairs",
              "store_origin",
              "tally_tag"
            ]
          }
        },
        {
          "from": "./eyes",
          "to": "/colony/graph",
          "condition": "has(hop.route) && hop.route == 'graph'"
        },
        {
          "from": "./eyes",
          "to": "/colony/registry",
          "condition": "has(hop.route) && hop.route == 'registry'"
        },
        {
          "from": "./lib",
          "to": "./weave",
          "condition": "has(hop.route) && hop.route == 'lib_out'"
        },
        {
          "from": "./eyes",
          "to": "./weave",
          "condition": "has(hop.route) && hop.route == 'eye_out'",
          "modifier": {
            "set_context": {
              "build_id": "hop.build_id",
              "iter": "hop.iter",
              "repairs": "hop.repairs"
            }
          }
        },
        {
          "from": "./unknown",
          "to": "./weave",
          "condition": "has(hop.route) && hop.route == 'unknown'"
        },
        {
          "from": "./weave",
          "to": "./transcript",
          "condition": "has(hop.route) && hop.route == 'cstore'",
          "modifier": {
            "set_context": {
              "store_origin": "'weave'"
            }
          }
        },
        {
          "from": "./transcript",
          "to": "./weave",
          "condition": "context.store_origin == 'weave'"
        },
        {
          "from": "./weave",
          "to": "./compose",
          "condition": "has(hop.route) && hop.route == 'fire' && int(context.iter) < 6",
          "modifier": {
            "set_context": {
              "iter": "int(context.iter) + 1",
              "build_call_id": "hop.build_call_id",
              "agent": "hop.agent",
              "build_op": "hop.build_op",
              "build_scope": "hop.build_scope",
              "build_caller": "hop.build_caller",
              "build_auto_submit": "hop.build_auto_submit"
            },
            "restore_ttl": true
          }
        },
        {
          "from": "./weave",
          "to": "./normalise",
          "condition": "has(hop.route) && (hop.route == 'draft' || (hop.route == 'fire' && int(context.iter) >= 6))",
          "modifier": {
            "set_context": {
              "build_call_id": "hop.build_call_id",
              "agent": "hop.agent",
              "build_op": "hop.build_op",
              "build_scope": "hop.build_scope",
              "build_caller": "hop.build_caller",
              "build_auto_submit": "hop.build_auto_submit"
            }
          }
        },
        {
          "from": ".",
          "to": "./weave",
          "condition": "has(hop.route) && hop.route == 'in_receipt'"
        },
        {
          "from": "./weave",
          "to": "./compose",
          "condition": "has(hop.route) && hop.route == 'repair' && has(hop.repairs) && int(hop.repairs) <= 2",
          "modifier": {
            "set_context": {
              "build_id": "hop.build_id",
              "iter": "hop.iter",
              "repairs": "hop.repairs",
              "build_call_id": "hop.build_call_id",
              "agent": "hop.agent",
              "build_op": "hop.build_op",
              "build_scope": "hop.build_scope",
              "build_caller": "hop.build_caller",
              "build_auto_submit": "hop.build_auto_submit"
            },
            "restore_ttl": true
          }
        },
        {
          "from": "./weave",
          "to": ".",
          "condition": "has(hop.route) && hop.route == 'give_up'",
          "modifier": {
            "set_hop": {
              "route": "'error'"
            },
            "set_context": {
              "build_call_id": "hop.build_call_id",
              "build_caller": "hop.build_caller",
              "build_auto_submit": "hop.build_auto_submit"
            },
            "delete_context": [
              "agent",
              "build_id",
              "build_op",
              "build_scope",
              "lib_call_id",
              "member_index",
              "repairs",
              "store_origin",
              "tally_tag"
            ]
          }
        },
        {
          "from": "./recipes",
          "to": ".",
          "condition": "has(hop.operation) && hop.operation == 'recipe' && !has(hop.error_code)",
          "modifier": {
            "set_hop": {
              "route": "'manifest'"
            },
            "delete_context": [
              "agent",
              "build_id",
              "build_op",
              "build_scope",
              "lib_call_id",
              "member_index",
              "repairs",
              "store_origin",
              "tally_tag"
            ]
          }
        },
        {
          "from": "./normalise",
          "to": ".",
          "condition": "has(hop.operation) && hop.operation == 'normalise' && !has(hop.error_code)",
          "modifier": {
            "set_hop": {
              "route": "'manifest'"
            },
            "delete_context": [
              "agent",
              "build_id",
              "build_op",
              "build_scope",
              "lib_call_id",
              "member_index",
              "repairs",
              "store_origin",
              "tally_tag"
            ]
          }
        },
        {
          "from": "./classify",
          "to": ".",
          "condition": "has(hop.operation) && hop.operation == 'classify' && has(hop.error_code)",
          "modifier": {
            "set_hop": {
              "route": "'error'"
            },
            "delete_context": [
              "agent",
              "build_id",
              "build_op",
              "build_scope",
              "lib_call_id",
              "member_index",
              "repairs",
              "store_origin",
              "tally_tag"
            ]
          }
        },
        {
          "from": "./recipes",
          "to": ".",
          "condition": "has(hop.operation) && hop.operation == 'recipe' && has(hop.error_code)",
          "modifier": {
            "set_hop": {
              "route": "'error'"
            },
            "delete_context": [
              "agent",
              "build_id",
              "build_op",
              "build_scope",
              "lib_call_id",
              "member_index",
              "repairs",
              "store_origin",
              "tally_tag"
            ]
          }
        },
        {
          "from": "./normalise",
          "to": ".",
          "condition": "has(hop.operation) && hop.operation == 'normalise' && has(hop.error_code)",
          "modifier": {
            "set_hop": {
              "route": "'error'"
            },
            "delete_context": [
              "agent",
              "build_id",
              "build_op",
              "build_scope",
              "lib_call_id",
              "member_index",
              "repairs",
              "store_origin",
              "tally_tag"
            ]
          }
        },
        {
          "from": "./normalise",
          "to": "./transcript",
          "condition": "has(hop.route) && hop.route == 'bind'",
          "modifier": {
            "set_context": {
              "store_origin": "'weave'"
            }
          }
        },
        {
          "from": "./recipes",
          "to": "./transcript",
          "condition": "has(hop.route) && hop.route == 'bind'",
          "modifier": {
            "set_context": {
              "store_origin": "'weave'"
            }
          }
        }
      ]
    }
  }
}
