{"schema": {"name": "text", "template": "text", "prop_schema": "json", "editable": "json", "layer": "text"}}
{"name": "stack", "template": "{{#if stylesheet}}<link rel=\"stylesheet\" href=\"/vision.css\">{{/if}}<div class=\"stack{{#if row}} stack--row{{/if}}\">{{children}}</div>", "prop_schema": {"stylesheet": "boolean", "row": "boolean"}, "editable": [], "layer": "content"}
{"name": "card", "template": "<section class=\"glass--thin card\">{{#if title}}<h2 class=\"title-3\">{{title}}</h2>{{/if}}<div class=\"inner\">{{children}}</div></section>", "prop_schema": {"title": "text"}, "editable": [], "layer": "navigation"}
{"name": "heading", "template": "<h2 class=\"title-2{{#if lead}} heading--lead{{/if}}\">{{text}}</h2>", "prop_schema": {"text": "text", "lead": "boolean"}, "editable": [], "layer": "content"}
{"name": "text", "template": "<p class=\"text{{#if secondary}} text--secondary{{/if}}\">{{body}}</p>", "prop_schema": {"body": "text", "secondary": "boolean"}, "editable": [], "layer": "content"}
{"name": "table", "template": "<table class=\"table\">{{#if caption}}<caption class=\"text--tertiary\">{{caption}}</caption>{{/if}}{{#if head}}<thead>{{&head}}</thead>{{/if}}<tbody>{{&rows}}</tbody></table>", "prop_schema": {"caption": "text", "head": "html", "rows": "html"}, "editable": [], "layer": "content"}
{"name": "button", "template": "<button class=\"button\" type=\"button\"{{#if event}} phx-click=\"{{event}}\"{{/if}}>{{label}}</button>", "prop_schema": {"label": "text", "event": "text"}, "editable": [], "layer": "content"}
{"name": "input", "template": "<input class=\"input\" type=\"text\" value=\"{{value}}\"{{#if placeholder}} placeholder=\"{{placeholder}}\"{{/if}}{{#if id}} phx-blur=\"object:set\" phx-value-id=\"{{id}}\" phx-value-prop=\"value\"{{/if}}>", "prop_schema": {"value": "text", "placeholder": "text", "id": "text"}, "editable": ["value"], "layer": "content"}
{"name": "badge", "template": "<span class=\"badge\">{{label}}</span>", "prop_schema": {"label": "text"}, "editable": [], "layer": "content"}
{"name": "ornament", "template": "<nav class=\"glass ornament\">{{children}}</nav>", "prop_schema": {}, "editable": [], "layer": "navigation"}
