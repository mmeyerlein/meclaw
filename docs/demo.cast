{"version": 2, "width": 100, "height": 30, "timestamp": 1781609000, "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}, "title": "meclaw: the loop is an edge"}
[0.2, "o", "# meclaw: build an agentic harness swarm as a directory tree.\r\n"]
[0.4, "o", "# starting the swarm colony as a daemon...\r\n"]
[0.52, "o", "\r\n"]
[0.92, "o", "$ curl -s http://127.0.0.1:7777/health\r\n"]
[1.12, "o", "ok\r\n"]
[1.32, "o", "# UI is live at http://127.0.0.1:7777/ui/\r\n"]
[1.44, "o", "\r\n"]
[1.64, "o", "# send the swarm a task. it enters at /prep:\r\n"]
[2.04, "o", "$ curl -X POST http://127.0.0.1:7777/messages -d '{...What is 6 * 7? Use a tool...}'\r\n"]
[3.24, "o", "\r\n"]
[3.44, "o", "{\"message_id\":\"019ed027-8666-72f2-962a-cfef30d1a786\"}\r\n"]
[3.56, "o", "\r\n"]
[5.06, "o", "# the trace: llm -> dispatch -> calc -> collector -> llm (the loopback) -> done\r\n"]
[5.26, "o", "  @external  -> /prep     \r\n"]
[5.46, "o", "  /prep      -> /llm      \r\n"]
[5.66, "o", "  /llm       -> /dispatch \r\n"]
[5.86, "o", "  /dispatch  -> /calc     \r\n"]
[6.06, "o", "  /calc      -> /collector\r\n"]
[6.26, "o", "  /collector -> /llm      \r\n"]
[6.46, "o", "  /llm       -> /done     \r\n"]
[6.58, "o", "\r\n"]
[6.78, "o", "# the answer, straight from the model, with the tool result fed back over an edge:\r\n"]
[6.98, "o", "  -> 42\r\n"]
[7.1, "o", "\r\n"]
[7.3, "o", "# dead letters:\r\n"]
[7.5, "o", "{\"dead_letters\":[]}\r\n"]
[7.62, "o", "\r\n"]
[7.82, "o", "# no loops were used in the making of this run. the loop is an edge.\r\n"]
