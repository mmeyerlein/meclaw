              },
              "memory-hive/closer": {
                "credential_grant_id": "grant:openrouter@colony-example/ava/memory-hive-closer",
                "x_title": "meclaw-example simple-agent-colony",
                "http_referer": "https://meclaw.ai"
              },
              "memory-hive/dialectic": {
                "credential_grant_id": "grant:openrouter@colony-example/ava/memory-hive-dialectic",
