                "credential_grant_id": "grant:openrouter@colony-example/ava/memory-hive-embed",
                "x_title": "meclaw-example simple-agent-colony",
                "http_referer": "https://meclaw.ai"
              },
              "door": {
                "agent_id": "ava"
              },
              "enrol": {
                "agent_id": "ava",
                "identity": {
                  "standard": {
                    "protocol": "AIEOS",
                    "version": "1.1.0"
                  },
                  "metadata": {
                    "instance_id": "ava-1"
                  },
                  "identity": {
                    "names": {
                      "first": "Ava",
                      "last": "Quill"
                    }
                  },
                  "motivations": {
                    "core_drive": "to keep the lighthouse"
                  }
                }
              },
              "tool_gate": {
                "tools_enabled": [
                  "weather"
                ]
              }
            }
          }
        ],
        "add_edges": [
          {
            "from": "./agent",
            "to": "./affinity",
            "condition": "has(hop.route) && hop.route == 'brief'",
            "modifier": {
              "set_hop": {
                "route": "'in_brief'"
              },
              "set_context": {
                "asker": "'agent:ava'",
                "audience_set": "has(context.audience_set) ? context.audience_set : ''",
                "brief_caller": "'agent'"
              }
            }
          },
          {
            "from": "./affinity",
            "to": "./agent/collector",
            "lane": "in_briefing",
            "condition": "has(hop.route) && (hop.route == 'answer' || hop.route == 'error') && has(context.brief_caller) && context.brief_caller == 'agent'",
            "modifier": {
              "set_hop": {
                "route": "'in_briefing'",
                "brief_outcome": "hop.route"
              },
              "delete_context": [
                "asker",
                "brief_caller"
              ]
            }
          },
          {
            "from": "./agent",
            "to": "./affinity",
            "condition": "has(hop.route) && hop.route == 'affinity_propose'",
            "modifier": {
              "set_hop": {
                "route": "'in_propose'"
              },
              "set_context": {
                "actor": "'agent:' + hop.agent_id",
                "subscriber": "has(context.sa_enrol) && context.sa_enrol == 'subscribe' ? 'agent:ava' : (has(context.sa_enrol) && context.sa_enrol == 'subscribe_brain' ? 'agent:ava/brain' : '')",
                "propose_caller": "'agent'"
              }
            }
          },
          {
            "from": "./affinity",
            "to": "./agent",
            "condition": "has(hop.route) && (hop.route == 'ack' || hop.route == 'error') && has(context.propose_caller) && context.propose_caller == 'agent'",
            "modifier": {
              "set_hop": {
                "route": "'in_propose_ack'",
                "propose_outcome": "hop.route"
              },
              "delete_context": [
                "actor",
                "propose_caller"
              ]
            }
          },
          {
            "from": "./affinity",
            "to": "./agent/curator",
            "lane": "in_pack",
            "condition": "has(hop.route) && hop.route == 'answer' && has(hop.subscriber) && (hop.subscriber == 'agent:ava' || hop.subscriber == 'agent:ava/brain')",
            "modifier": {
              "set_hop": {
                "route": "'in_pack'"
              },
              "set_context": {
                "pack_sub": "hop.pack_sub",
                "pack_hash": "hop.pack_hash"
              }
            }
          },
          {
            "from": "./agent",
            "to": "./affinity",
            "condition": "has(hop.route) && hop.route == 'pack_ack' && has(context.pack_sub) && context.pack_sub != ''",
            "modifier": {
              "set_hop": {
                "route": "'in_pack_ack'"
              }
            }
          },
          {
            "from": ".",
            "to": "./agent",
            "condition": "has(hop.route) && hop.route == 'mutation_committed'"
          },
          {
            "from": "./llm-registry",
            "to": "./agent",
            "condition": "has(hop.route) && hop.route == 'update' && has(hop.subscriber) && hop.subscriber.startsWith('/agent/')",
            "modifier": {
              "set_hop": {
                "route": "'in_model'"
              }
            }
          },
          {
            "from": "./llm-registry",
            "to": "./agent",
            "condition": "has(hop.route) && hop.route == 'in_model' && (!has(hop.subscriber) || hop.subscriber.startsWith('/agent/'))"
          },
          {
            "from": "./agent",
            "to": "./llm-registry",
            "condition": "has(hop.route) && hop.route == 'model_refused'",
            "modifier": {
              "set_hop": {
                "route": "'in_refused'"
              },
              "delete_context": [
                "actor"
              ]
            }
          },
          {
            "from": ".",
            "to": "./llm-registry",
            "condition": "has(hop.route) && hop.route == 'mutation_committed'",
            "modifier": {
              "set_hop": {
                "route": "'in_hand'"
              },
              "set_context": {
                "model_announcer": "'simple_agent'",
                "model_generation": "'/agent'",
                "model_announced": "'[{\"cell_path\":\"/agent/brain\",\"start_model\":\"example-provider/brain-model\",\"requirement\":\"The one mind of a general-purpose agent: it reads a conversation, plans, calls tools over several steps, reads their results and answers when the work is done. It needs dependable native tool calling, sound multi-step reasoning and a long context; a caller waits on every turn, so a reply should start within seconds and the price per call should stay moderate.\"}]'"
              },
              "delete_context": [
                "actor"
              ]
            }
          },
          {
            "from": "./agent/brain",
            "to": "./access",
            "lane": "credential_request",
            "condition": "has(hop.route) && hop.route == 'credential_request'",
            "modifier": {
              "set_hop": {
                "route": "'in_invoke'"
              },
              "set_context": {
                "requester": "'agent:agent/brain'"
              }
            }
          },
          {
            "from": "./access",
            "to": "./agent/brain",
            "lane": "in_sealed",
            "condition": "has(hop.route) && hop.route == 'ack' && has(hop.operation) && hop.operation == 'vault.deliver' && has(hop.grant_id) && hop.grant_id == 'grant:openrouter@colony-example/ava/brain'",
            "modifier": {
              "set_hop": {
                "route": "'in_sealed'"
              }
            }
