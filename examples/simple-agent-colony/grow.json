      "scope": "/",
      "ctx": {
        "model": "example-provider/brain-model"
      },
      "diff": {
        "add_nodes": [
          {
            "name": "agent",
            "template": "simple-agent@2.1.1",
            "override_params": {
              "brain": {
                "credential_grant_id": "grant:openrouter@colony-example/ava/brain",
                "x_title": "meclaw-example simple-agent-colony",
                "http_referer": "https://meclaw.ai"
              },
              "curator/summarizer": {
                "credential_grant_id": "grant:openrouter@colony-example/ava/curator-summarizer",
