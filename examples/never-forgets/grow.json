{
  "scope": "/",
  "ctx": {
    "model": "${MODEL_BRAIN}"
  },
  "diff": {
    "add_nodes": [
      {
        "name": "surface",
        "template": "door"
      },
      {
        "name": "talky",
        "template": "talky",
        "override_params": {
          "collector/assemble": {
            "turn_write": "1"
          }
        }
      },
      {
        "name": "drain",
        "template": "memory-drain"
      },
      {
        "name": "sink",
        "template": "terminal"
      }
    ],
    "add_edges": [
      {
        "from": "./surface",
        "to": "./talky",
        "condition": "has(hop.route) && hop.route == 'turn'",
        "modifier": {
          "set_hop": {
            "route": "'in_turn'"
          },
          "set_context": {
            "channel": "hop.chat_id",
            "audience_set": "'[\"member:alex\",\"agent:scribe\"]'"
          }
        }
      },
      {
        "from": "./replay",
        "to": "./memory/keep",
        "condition": "has(hop.route) && hop.route == 'episode'",
        "modifier": {
          "set_hop": {
            "route": "'in_episode'"
          },
          "set_context": {
            "session_id": "hop.session_id",
            "turn_id": "hop.turn_id",
            "happened_at": "hop.happened_at"
          }
        }
      },
      {
        "from": "./talky",
        "to": "./drain",
        "condition": "has(hop.route) && hop.route == 'turn_write'",
        "modifier": {
          "set_hop": {
            "route": "'in_batch'"
          },
          "set_context": {
            "session_id": "hop.session_id"
          }
        }
      },
      {
        "from": "./talky",
        "to": "./drain",
        "condition": "has(hop.route) && hop.route == 'write'",
        "modifier": {
          "set_hop": {
            "route": "'in_batch'"
          },
          "set_context": {
            "session_id": "hop.session_id"
          }
        }
      },
      {
        "from": "./drain",
        "to": "./memory/keep",
        "condition": "has(hop.route) && hop.route == 'episode'",
        "modifier": {
          "set_hop": {
            "route": "'in_episode'"
          },
          "set_context": {
            "session_id": "hop.session_id",
            "turn_id": "hop.turn_id",
            "happened_at": "hop.happened_at"
          }
        }
      },
      {
        "from": "./talky",
        "to": "./talky",
        "condition": "has(hop.route) && hop.route == 'tool' && has(hop.tool_name) && hop.tool_name == 'memory_recall'",
        "modifier": {
          "set_hop": {
            "route": "'in_memory_call'"
          }
        }
      },
      {
        "from": "./talky",
        "to": "./memory/keep",
        "condition": "has(hop.route) && hop.route == 'recall'",
        "modifier": {
          "set_hop": {
            "route": "'in_recall'"
          },
          "set_context": {
            "recall_query": "hop.recall_query",
            "memory_tier": "hop.memory_tier",
            "memory_call_id": "hop.memory_call_id",
            "recall_window_from": "hop.recall_window_from",
            "recall_window_to": "hop.recall_window_to",
            "turn_id": "hop.turn_id",
            "session_id": "hop.session_id",
            "iter": "hop.iter"
          }
        }
      },
      {
        "from": "./memory/keep",
        "to": "./talky",
        "condition": "has(hop.route) && hop.route == 'bundle'",
        "modifier": {
          "set_hop": {
            "route": "'in_bundle'"
          },
          "set_context": {
            "memory_call_id": "hop.memory_call_id",
            "turn_id": "hop.turn_id",
            "session_id": "hop.session_id",
            "iter": "hop.iter"
          }
        }
      },
      {
        "from": "./talky",
        "to": "./sink",
        "condition": "has(hop.route) && hop.route == 'answer'"
      },
      {
        "from": "./talky",
        "to": "./sink",
        "condition": "has(hop.route) && hop.route == 'error'"
      },
      {
        "from": "./drain",
        "to": "./sink",
        "condition": "has(hop.route) && hop.route == 'reject'"
      }
    ]
  }
}
