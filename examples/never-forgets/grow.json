{
  "scope": "/",
  "ctx": {
    "model": "${MODEL_BRAIN}"
  },
  "diff": {
    "add_nodes": [
      {
        "name": "door",
        "template": "door"
      },
      {
        "name": "talky",
        "template": "talky",
        "override_params": {
          "collector/assemble": {
            "turn_write": "1"
          }
        }
      },
      {
        "name": "sink",
        "template": "terminal"
      }
    ],
    "add_edges": [
      {
        "from": "./door",
        "to": "./talky",
        "condition": "has(hop.route) && hop.route == 'turn'",
        "modifier": {
          "set_hop": {
            "route": "'in_turn'"
          },
          "set_context": {
            "channel": "hop.chat_id",
            "audience_set": "'[\"member:alex\",\"agent:scribe\"]'"
          }
        }
      },
      {
        "from": "./replay",
        "to": "./memory/keep",
        "condition": "has(hop.route) && hop.route == 'episode'",
        "modifier": {
          "set_hop": {
            "route": "'in_episode'"
          },
          "set_context": {
            "session_id": "hop.session_id",
            "turn_id": "hop.turn_id",
            "happened_at": "hop.happened_at"
          }
        }
      },
      {
        "from": "./talky",
        "to": "./memory/keep",
        "condition": "has(hop.route) && hop.route == 'turn_write'",
        "modifier": {
          "set_hop": {
            "route": "'in_episode'"
          },
          "set_context": {
            "session_id": "hop.session_id",
            "turn_id": "hop.turn_id",
            "happened_at": "hop.happened_at"
          }
        }
      },
      {
        "from": "./talky",
        "to": "./memory/keep",
        "condition": "has(hop.route) && hop.route == 'tool' && has(hop.tool_name) && hop.tool_name == 'memory_recall'",
        "modifier": {
          "set_hop": {
            "route": "'in_call'"
          }
        }
      },
      {
        "from": "./memory/keep",
        "to": "./talky",
        "condition": "has(hop.route) && hop.route == 'result'",
        "modifier": {
          "set_hop": {
            "route": "'in_tool'"
          }
        }
      },
      {
        "from": "./talky",
        "to": "./sink",
        "condition": "has(hop.route) && hop.route == 'answer'"
      }
    ]
  }
}
