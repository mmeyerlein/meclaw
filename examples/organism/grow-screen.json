{
  "manifest": [
    {
      "scope": "/os/orgs/acme/members/alex/channels",
      "diff": {
        "add_nodes": [
          {
            "name": "display-desk",
            "template": "display@1.0.2",
            "override_params": {
              "web": {
                "port": 7902
              }
            }
          }
        ],
        "add_edges": [
          {
            "from": "./display-desk",
            "to": ".",
            "condition": "has(hop.route) && (hop.route == 'event' || hop.route == 'receipt')",
            "modifier": {
              "set_context": {
                "channel_node": "'display-desk'",
                "channel": "'display-desk'"
              }
            }
          },
          {
            "from": ".",
            "to": "./display-desk",
            "condition": "has(hop.route) && (hop.route == 'answer' || hop.route == 'view') && has(context.channel_node) && context.channel_node == 'display-desk'",
            "modifier": {
              "set_hop": {
                "route": "'in_view'"
              }
            }
          }
        ]
      }
    },
    {
      "scope": "/os/orgs/acme/members/alex/apps",
      "diff": {
        "add_nodes": [
          {
            "name": "colony-view",
            "template": "colony-view@1.0.2"
          }
        ],
        "add_edges": [
          {
            "from": "./colony-view",
            "to": ".",
            "condition": "has(hop.route) && (hop.route == 'view' || hop.route == 'error')",
            "modifier": {
              "set_context": {
                "channel_node": "'display-desk'",
                "channel": "'display-desk'"
              }
            }
          },
          {
            "from": ".",
            "to": "./colony-view",
            "condition": "has(hop.route) && (hop.route == 'event' || hop.route == 'receipt') && has(hop.owner) && hop.owner.contains('/apps/colony-view/')"
          }
        ]
      }
    },
    {
      "scope": "/os/orgs/acme/members/alex/assistants",
      "diff": {
        "add_edges": [
          {
            "from": ".",
            "to": "./scribe",
            "condition": "has(hop.route) && hop.route == 'in_turn' && has(hop.owner) && hop.owner.contains('/assistants/scribe/')"
          }
        ]
      }
    }
  ]
}
