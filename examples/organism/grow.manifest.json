{
  "manifest": [
    {
      "scope": "/",
      "diff": {
        "add_nodes": [
          {
            "name": "os",
            "template": "meclaw-os@1.2.3"
          }
        ],
        "add_edges": []
      }
    },
    {
      "scope": "/os",
      "diff": {
        "add_nodes": [
          {
            "name": "orgs/acme",
            "template": "org@1.1.0"
          }
        ],
        "add_edges": [
          {
            "from": "./orgs",
            "to": "./orgs/acme",
            "condition": "has(hop.route) && hop.route == 'in_turn'"
          },
          {
            "from": "./orgs",
            "to": "./orgs/acme",
            "condition": "has(hop.route) && hop.route == 'in_recall'"
          },
          {
            "from": "./orgs",
            "to": "./orgs/acme",
            "condition": "has(hop.route) && hop.route == 'in_brief'"
          },
          {
            "from": "./orgs",
            "to": "./orgs/acme",
            "condition": "has(hop.route) && hop.route == 'in_propose'"
          },
          {
            "from": "./orgs/acme",
            "to": "./orgs",
            "condition": "has(hop.route) && hop.route == 'answer'"
          },
          {
            "from": "./orgs/acme",
            "to": "./orgs",
            "condition": "has(hop.route) && hop.route == 'ack'"
          },
          {
            "from": "./orgs/acme",
            "to": "./orgs",
            "condition": "has(hop.route) && hop.route == 'reject'"
          },
          {
            "from": "./orgs/acme",
            "to": "./orgs",
            "condition": "has(hop.route) && hop.route == 'error'"
          },
          {
            "from": "./orgs/acme",
            "to": "./orgs",
            "condition": "has(hop.route) && hop.route == 'write'"
          },
          {
            "from": "./orgs/acme",
            "to": "./orgs",
            "condition": "has(hop.route) && hop.route == 'turn_write'"
          },
          {
            "from": "./orgs/acme",
            "to": "./orgs",
            "condition": "has(hop.route) && hop.route == 'prune'"
          },
          {
            "from": "./orgs/acme",
            "to": "./orgs",
            "condition": "has(hop.route) && hop.route == 'build'"
          },
          {
            "from": "./orgs",
            "to": "./orgs/acme",
            "condition": "has(hop.route) && hop.route == 'in_build_result'"
          }
        ]
      }
    },
    {
      "scope": "/os/orgs/acme",
      "diff": {
        "add_nodes": [
          {
            "name": "members/alex",
            "template": "member@1.1.0"
          }
        ],
        "add_edges": [
          {
            "from": "./members",
            "to": "./members/alex",
            "condition": "has(hop.route) && hop.route == 'in_turn'"
          },
          {
            "from": "./members",
            "to": "./members/alex",
            "condition": "has(hop.route) && hop.route == 'in_recall'"
          },
          {
            "from": "./members",
            "to": "./members/alex",
            "condition": "has(hop.route) && hop.route == 'in_brief'"
          },
          {
            "from": "./members",
            "to": "./members/alex",
            "condition": "has(hop.route) && hop.route == 'in_propose'"
          },
          {
            "from": "./members/alex",
            "to": "./members",
            "condition": "has(hop.route) && hop.route == 'answer'"
          },
          {
            "from": "./members/alex",
            "to": "./members",
            "condition": "has(hop.route) && hop.route == 'ack'"
          },
          {
            "from": "./members/alex",
            "to": "./members",
            "condition": "has(hop.route) && hop.route == 'reject'"
          },
          {
            "from": "./members/alex",
            "to": "./members",
            "condition": "has(hop.route) && hop.route == 'error'"
          },
          {
            "from": "./members/alex",
            "to": "./members",
            "condition": "has(hop.route) && hop.route == 'write'"
          },
          {
            "from": "./members/alex",
            "to": "./members",
            "condition": "has(hop.route) && hop.route == 'turn_write'"
          },
          {
            "from": "./members/alex",
            "to": "./members",
            "condition": "has(hop.route) && hop.route == 'prune'"
          },
          {
            "from": "./members/alex",
            "to": "./members",
            "condition": "has(hop.route) && hop.route == 'build'"
          },
          {
            "from": "./members",
            "to": "./members/alex",
            "condition": "has(hop.route) && hop.route == 'in_build_result'"
          }
        ]
      }
    },
    {
      "scope": "/os/orgs/acme/members/alex",
      "ctx": {
        "model": "${MODEL_CORE}",
        "model_fast": "${MODEL_CORE_FAST}"
      },
      "diff": {
        "add_nodes": [
          {
            "name": "assistants/scribe",
            "template": "assistant@1.1.0",
            "override_params": {
              "cogny/brain": {
                "temperature": 0.2
              }
            }
          }
        ],
        "add_edges": [
          {
            "from": "./assistants",
            "to": "./assistants/scribe",
            "condition": "has(hop.route) && hop.route == 'in_turn' && has(context.agent) && context.agent == 'scribe'"
          },
          {
            "from": "./assistants",
            "to": "./assistants/scribe",
            "condition": "has(hop.route) && hop.route == 'in_bundle' && has(context.agent) && context.agent == 'scribe'"
          },
          {
            "from": "./assistants/scribe",
            "to": "./assistants",
            "condition": "has(hop.route) && hop.route == 'turn'"
          },
          {
            "from": "./assistants/scribe",
            "to": "./assistants",
            "condition": "has(hop.route) && hop.route == 'recall'"
          },
          {
            "from": "./assistants/scribe",
            "to": "./assistants",
            "condition": "has(hop.route) && hop.route == 'extraction'"
          },
          {
            "from": "./assistants/scribe",
            "to": "./assistants",
            "condition": "has(hop.route) && hop.route == 'write'"
          },
          {
            "from": "./assistants/scribe",
            "to": "./assistants",
            "condition": "has(hop.route) && hop.route == 'turn_write'"
          },
          {
            "from": "./assistants/scribe",
            "to": "./assistants",
            "condition": "has(hop.route) && hop.route == 'prune'"
          },
          {
            "from": "./assistants/scribe",
            "to": "./assistants",
            "condition": "has(hop.route) && hop.route == 'error'"
          },
          {
            "from": "./assistants/scribe",
            "to": "./assistants",
            "condition": "has(hop.route) && hop.route == 'build'",
            "modifier": {
              "set_context": {
                "agent": "'scribe'"
              }
            }
          },
          {
            "from": "./assistants",
            "to": "./assistants/scribe",
            "condition": "has(hop.route) && hop.route == 'in_build_result' && (!has(context.agent) || context.agent == 'scribe')"
          }
        ]
      }
    },
    {
      "scope": "/os/orgs/acme/members/alex/assistants/scribe",
      "ctx": {
        "model": "${MODEL_BRAIN}"
      },
      "diff": {
        "add_nodes": [
          {
            "name": "channels/telegram-connector",
            "template": "telegram-connector@2.0.1"
          },
          {
            "name": "channels/talky",
            "template": "talky@4.2.3"
          }
        ],
        "add_edges": [
          {
            "from": "./channels/telegram-connector",
            "to": "./channels",
            "condition": "!has(hop.error_code)",
            "modifier": {
              "set_hop": {
                "route": "'turn'"
              },
              "set_context": {
                "channel": "'telegram'",
                "agent": "'scribe'",
                "chat_id": "hop.chat_id",
                "user_id": "hop.user_id",
                "audience_set": "'[\"member:alex\",\"agent:scribe\"]'"
              }
            }
          },
          {
            "from": "./channels/telegram-connector",
            "to": "./channels",
            "condition": "has(hop.error_code)",
            "modifier": {
              "set_hop": {
                "route": "'error'"
              }
            }
          },
          {
            "from": "./channels/talky",
            "to": "./channels/telegram-connector",
            "condition": "has(hop.route) && hop.route == 'answer'"
          },
          {
            "from": "./channels",
            "to": "./channels/talky",
            "condition": "has(hop.route) && hop.route == 'in_turn'"
          },
          {
            "from": "./channels",
            "to": "./channels/talky",
            "condition": "has(hop.route) && hop.route == 'in_bundle'"
          },
          {
            "from": "./channels",
            "to": "./channels/talky",
            "condition": "has(hop.route) && hop.route == 'in_advice'"
          },
          {
            "from": "./channels",
            "to": "./channels/talky",
            "condition": "has(hop.route) && hop.route == 'in_sweep'"
          },
          {
            "from": "./channels",
            "to": "./channels/talky",
            "condition": "has(hop.route) && hop.route == 'in_prune'"
          },
          {
            "from": "./channels",
            "to": "./channels/talky",
            "condition": "has(hop.route) && hop.route == 'in_round_sweep'"
          },
          {
            "from": "./channels",
            "to": "./channels/talky",
            "condition": "has(hop.route) && hop.route == 'in_tool'"
          },
          {
            "from": "./channels/talky",
            "to": "./channels",
            "condition": "has(hop.route) && hop.route == 'write'"
          },
          {
            "from": "./channels/talky",
            "to": "./channels",
            "condition": "has(hop.route) && hop.route == 'turn_write'"
          },
          {
            "from": "./channels/talky",
            "to": "./channels",
            "condition": "has(hop.route) && hop.route == 'extraction'"
          },
          {
            "from": "./channels/talky",
            "to": "./channels",
            "condition": "has(hop.route) && hop.route == 'recall'"
          },
          {
            "from": "./channels/talky",
            "to": "./channels",
            "condition": "has(hop.route) && hop.route == 'tool'"
          },
          {
            "from": "./channels/talky",
            "to": "./channels",
            "condition": "has(hop.route) && hop.route == 'prune'"
          },
          {
            "from": "./channels/talky",
            "to": "./channels",
            "condition": "has(hop.route) && hop.route == 'error'"
          }
        ]
      }
    }
  ]
}
