                "cred_ref": "cred:example-provider:primary",
                "purpose": "authenticate scribe's cogny brain against the provider",
                "issued_at": "2026-01-01T00:00:00.000000Z",
                "expires_at": "2099-01-01T00:00:00.000000Z",
                "rule_id": "alex-credential-read",
                "constraints": {
                  "rate_per_min": 60
                }
              }
            ]
          },
          {
            "target": "./access/store",
            "table": "grant_events",
            "rows": [
              {
                "id": "ev-organism-0000000001",
                "grant_id": "grant:example-provider-primary@member-alex/talky",
                "event": "granted",
                "at": "2026-01-01T00:00:00.000000Z",
                "actor": "operator",
                "reason_code": "",
                "detail": {
                  "why": "seeded with the level: credential_grant_id is immutable, so the grant has to exist before the brain that names it ever asks"
                }
              },
              {
                "id": "ev-organism-0000000002",
                "grant_id": "grant:example-provider-primary@member-alex/cogny",
                "event": "granted",
