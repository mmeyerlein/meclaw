{
  "manifest": [
    {
      "scope": "/",
      "diff": {
        "add_nodes": [
          {
            "name": "os",
            "template": "meclaw-os@1.6.0"
          }
        ],
        "add_edges": []
      }
    },
    {
      "scope": "/os/orgs",
      "diff": {
        "add_nodes": [
          {
            "name": "acme",
            "template": "org@1.3.0"
          }
        ],
        "add_edges": [
          {
            "from": ".",
            "to": "./acme",
            "condition": "has(hop.route) && hop.route == 'in_turn' && (!has(context.org) || context.org == 'acme')"
          },
          {
            "from": ".",
            "to": "./acme",
            "condition": "has(hop.route) && hop.route == 'in_recall' && (!has(context.org) || context.org == 'acme')"
          },
          {
            "from": ".",
            "to": "./acme",
            "condition": "has(hop.route) && hop.route == 'in_brief' && (!has(context.org) || context.org == 'acme')"
          },
          {
            "from": ".",
            "to": "./acme",
            "condition": "has(hop.route) && hop.route == 'in_propose' && (!has(context.org) || context.org == 'acme')"
          },
          {
            "from": ".",
            "to": "./acme",
            "condition": "has(hop.route) && hop.route == 'in_build_result' && (!has(context.org) || context.org == 'acme')"
          },
          {
            "from": ".",
            "to": "./acme",
            "condition": "has(hop.route) && hop.route == 'in_export' && (!has(context.org) || context.org == 'acme')"
          },
          {
            "from": "./acme",
            "to": ".",
            "condition": "has(hop.route) && hop.route == 'answer'"
          },
          {
            "from": "./acme",
            "to": ".",
            "condition": "has(hop.route) && hop.route == 'bundle'"
          },
          {
            "from": "./acme",
            "to": ".",
            "condition": "has(hop.route) && hop.route == 'ack'"
          },
          {
            "from": "./acme",
            "to": ".",
            "condition": "has(hop.route) && hop.route == 'reject'"
          },
          {
            "from": "./acme",
            "to": ".",
            "condition": "has(hop.route) && hop.route == 'error'"
          },
          {
            "from": "./acme",
            "to": ".",
            "condition": "has(hop.route) && hop.route == 'write'"
          },
          {
            "from": "./acme",
            "to": ".",
            "condition": "has(hop.route) && hop.route == 'turn_write'"
          },
          {
            "from": "./acme",
            "to": ".",
            "condition": "has(hop.route) && hop.route == 'prune'"
          },
          {
            "from": "./acme",
            "to": ".",
            "condition": "has(hop.route) && hop.route == 'build'"
          },
          {
            "from": "./acme",
            "to": ".",
            "condition": "has(hop.route) && hop.route == 'close_report'"
          },
          {
            "from": "./acme",
            "to": ".",
            "condition": "has(hop.route) && hop.route == 'export_done'"
          },
          {
            "from": "./acme",
            "to": ".",
            "condition": "has(hop.route) && hop.route == 'pack_ack'"
          }
        ]
      }
    },
    {
      "scope": "/os/orgs/acme/members",
      "diff": {
        "add_nodes": [
          {
            "name": "alex",
            "template": "member@1.4.0"
          }
        ],
        "add_edges": [
          {
            "from": ".",
            "to": "./alex",
            "condition": "has(hop.route) && hop.route == 'in_turn' && (!has(context.member) || context.member == 'alex')"
          },
          {
            "from": ".",
            "to": "./alex",
            "condition": "has(hop.route) && hop.route == 'in_recall' && (!has(context.member) || context.member == 'alex')"
          },
          {
            "from": ".",
            "to": "./alex",
            "condition": "has(hop.route) && hop.route == 'in_brief' && (!has(context.member) || context.member == 'alex')"
          },
          {
            "from": ".",
            "to": "./alex",
            "condition": "has(hop.route) && hop.route == 'in_propose' && (!has(context.member) || context.member == 'alex')"
          },
          {
            "from": ".",
            "to": "./alex",
            "condition": "has(hop.route) && hop.route == 'in_build_result' && (!has(context.member) || context.member == 'alex')"
          },
          {
            "from": ".",
            "to": "./alex",
            "condition": "has(hop.route) && hop.route == 'in_export' && (!has(context.member) || context.member == 'alex')"
          },
          {
            "from": "./alex",
            "to": ".",
            "condition": "has(hop.route) && hop.route == 'answer'"
          },
          {
            "from": "./alex",
            "to": ".",
            "condition": "has(hop.route) && hop.route == 'bundle'"
          },
          {
            "from": "./alex",
            "to": ".",
            "condition": "has(hop.route) && hop.route == 'ack'"
          },
          {
            "from": "./alex",
            "to": ".",
            "condition": "has(hop.route) && hop.route == 'reject'"
          },
          {
            "from": "./alex",
            "to": ".",
            "condition": "has(hop.route) && hop.route == 'error'"
          },
          {
            "from": "./alex",
            "to": ".",
            "condition": "has(hop.route) && hop.route == 'write'"
          },
          {
            "from": "./alex",
            "to": ".",
            "condition": "has(hop.route) && hop.route == 'turn_write'"
          },
          {
            "from": "./alex",
            "to": ".",
            "condition": "has(hop.route) && hop.route == 'prune'"
          },
          {
            "from": "./alex",
            "to": ".",
            "condition": "has(hop.route) && hop.route == 'build'"
          },
          {
            "from": "./alex",
            "to": ".",
            "condition": "has(hop.route) && hop.route == 'close_report'"
          },
          {
            "from": "./alex",
            "to": ".",
            "condition": "has(hop.route) && hop.route == 'export_done'"
          },
          {
            "from": "./alex",
            "to": ".",
            "condition": "has(hop.route) && hop.route == 'pack_ack'"
          }
        ]
      }
    },
    {
      "scope": "/os/orgs/acme/members/alex/assistants",
      "ctx": {
        "model": "${MODEL_CORE}",
        "model_fast": "${MODEL_CORE_FAST}",
        "model_surface": "${MODEL_SURFACE}"
      },
      "diff": {
        "add_nodes": [
          {
            "name": "scribe",
            "template": "assistant@2.2.0",
            "override_params": {
              "cogny/brain": {
                "temperature": 0.2
              }
            }
          }
        ],
        "add_edges": [
          {
            "from": ".",
            "to": "./scribe",
            "condition": "has(hop.route) && hop.route == 'in_turn' && has(context.assistant) && context.assistant == 'scribe'"
          },
          {
            "from": ".",
            "to": "./scribe",
            "condition": "has(hop.route) && hop.route == 'in_bundle' && has(context.assistant) && context.assistant == 'scribe'"
          },
          {
            "from": "./scribe",
            "to": ".",
            "condition": "has(hop.route) && hop.route == 'answer'"
          },
          {
            "from": "./scribe",
            "to": ".",
            "condition": "has(hop.route) && hop.route == 'recall'"
          },
          {
            "from": "./scribe",
            "to": ".",
            "condition": "has(hop.route) && hop.route == 'extraction'"
          },
          {
            "from": "./scribe",
            "to": ".",
            "condition": "has(hop.route) && hop.route == 'write'"
          },
          {
            "from": "./scribe",
            "to": ".",
            "condition": "has(hop.route) && hop.route == 'turn_write'"
          },
          {
            "from": "./scribe",
            "to": ".",
            "condition": "has(hop.route) && hop.route == 'prune'"
          },
          {
            "from": "./scribe",
            "to": ".",
            "condition": "has(hop.route) && hop.route == 'error'"
          },
          {
            "from": "./scribe",
            "to": ".",
            "condition": "has(hop.route) && hop.route == 'build'",
            "modifier": {
              "set_context": {
                "assistant": "'scribe'"
              }
            }
          },
          {
            "from": ".",
            "to": "./scribe",
            "condition": "has(hop.route) && hop.route == 'in_build_result' && (!has(context.assistant) || context.assistant == 'scribe')"
          },
          {
            "from": ".",
            "to": "./scribe",
            "condition": "has(hop.route) && hop.route == 'in_export' && has(context.assistant) && context.assistant == 'scribe'"
          },
          {
            "from": ".",
            "to": "./scribe",
            "condition": "has(hop.route) && hop.route == 'in_import' && has(context.assistant) && context.assistant == 'scribe'"
          },
          {
            "from": "./scribe",
            "to": ".",
            "condition": "has(hop.route) && hop.route == 'dump'"
          }
        ]
      }
    },
    {
      "scope": "/os/orgs/acme/members/alex/channels",
      "ctx": {
        "member_person": "alex"
      },
      "diff": {
        "add_nodes": [
          {
            "name": "telegram",
            "template": "telegram-connector@2.0.1",
            "birth": "inactive"
          }
        ],
        "add_edges": [
          {
            "from": "./telegram",
            "to": ".",
            "condition": "!has(hop.error_code)",
            "modifier": {
              "set_hop": {
                "route": "'turn'"
              },
              "set_context": {
                "channel_node": "'telegram'",
                "channel": "has(hop.chat_id) ? hop.chat_id : ''",
                "assistant": "has(context.assistant) && context.assistant != '' ? context.assistant : (has(hop.addressed_to) && hop.addressed_to != '' ? hop.addressed_to : 'scribe')",
                "chat_id": "has(hop.chat_id) ? hop.chat_id : ''",
                "user_id": "has(hop.user_id) ? hop.user_id : ''",
                "audience_set": "'[\"agent:scribe\",\"member:alex\"]'"
              }
            }
          },
          {
            "from": "./telegram",
            "to": ".",
            "condition": "has(hop.error_code)",
            "modifier": {
              "set_hop": {
                "route": "'error'"
              }
            }
          },
          {
            "from": ".",
            "to": "./telegram",
            "condition": "has(hop.route) && hop.route == 'answer' && has(context.channel_node) && context.channel_node == 'telegram'"
          }
        ]
      }
    }
  ]
}
