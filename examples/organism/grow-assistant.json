{
  "scope": "/os/orgs/acme/members/alex/assistants",
  "ctx": {
    "model": "${MODEL_CORE}",
    "model_fast": "${MODEL_CORE_FAST}",
    "model_surface": "${MODEL_SURFACE}"
  },
  "diff": {
    "add_nodes": [
      {
        "name": "scribe",
        "template": "assistant@2.2.0",
        "override_params": {
          "cogny/brain": {
            "temperature": 0.2
          }
        }
      }
    ],
    "add_edges": [
      {
        "from": ".",
        "to": "./scribe",
        "condition": "has(hop.route) && hop.route == 'in_turn' && has(context.assistant) && context.assistant == 'scribe'"
      },
      {
        "from": ".",
        "to": "./scribe",
        "condition": "has(hop.route) && hop.route == 'in_bundle' && has(context.assistant) && context.assistant == 'scribe'"
      },
      {
        "from": "./scribe",
        "to": ".",
        "condition": "has(hop.route) && hop.route == 'answer'"
      },
      {
        "from": "./scribe",
        "to": ".",
        "condition": "has(hop.route) && hop.route == 'recall'"
      },
      {
        "from": "./scribe",
        "to": ".",
        "condition": "has(hop.route) && hop.route == 'extraction'"
      },
      {
        "from": "./scribe",
        "to": ".",
        "condition": "has(hop.route) && hop.route == 'write'"
      },
      {
        "from": "./scribe",
        "to": ".",
        "condition": "has(hop.route) && hop.route == 'turn_write'"
      },
      {
        "from": "./scribe",
        "to": ".",
        "condition": "has(hop.route) && hop.route == 'prune'"
      },
      {
        "from": "./scribe",
        "to": ".",
        "condition": "has(hop.route) && hop.route == 'error'"
      },
      {
        "from": "./scribe",
        "to": ".",
        "condition": "has(hop.route) && hop.route == 'build'",
        "modifier": {
          "set_context": {
            "assistant": "'scribe'"
          }
        }
      },
      {
        "from": ".",
        "to": "./scribe",
        "condition": "has(hop.route) && hop.route == 'in_build_result' && (!has(context.assistant) || context.assistant == 'scribe')"
      },
      {
        "from": ".",
        "to": "./scribe",
        "condition": "has(hop.route) && hop.route == 'in_export' && has(context.assistant) && context.assistant == 'scribe'"
      },
      {
        "from": ".",
        "to": "./scribe",
        "condition": "has(hop.route) && hop.route == 'in_import' && has(context.assistant) && context.assistant == 'scribe'"
      },
      {
        "from": "./scribe",
        "to": ".",
        "condition": "has(hop.route) && hop.route == 'dump'"
      }
    ]
  }
}
