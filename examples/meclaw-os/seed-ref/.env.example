# examples/meclaw-os/seed-ref/.env.example -- copy to `.env` beside it.
#
# This file is the roll-up of `templates/meclaw-os/template.json` § requires.env,
# in the same order, and nothing here carries a value: every line is a
# PLACEHOLDER. The names of the secrets travel with the repository; the secrets
# themselves never do.
#
# One key is REQUIRED. Without it the first boot refuses the growth with
# `requirement_missing`, naming the key and the sentence that says why, before a
# single byte is staged -- the marker in `main/os/` is still a marker afterwards.
# Everything else has a default in the template it configures, is declared so
# that a builder learns this shell's environment surface by reading it, and is
# listed here with that default spelled out.

# -- required ------------------------------------------------------------------
# The control loop's judge. The one value in the shell written with no default.
OPENROUTER_API_KEY=sk-your-key-here

# -- the authoring path (stage two cannot run without these) --------------------
# The composer has an empty default for all three, so the shell boots without
# them -- and drafts nothing. Set them before the first authoring round.
MODEL_BUILDER=
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=
# How many catalogue entries one library lookup returns.
BUILDER_LIBRARIAN_TOPK=5
BUILDER_LIBRARIAN_CATALOGUE_CHARS=4000
BUILDER_LIBRARIAN_ROW_CHARS=1200
# The tool round of the authoring path.
DISPATCHER_MAX_CALLS=16
DISPATCHER_ASYNC_TOOLS=
DISPATCHER_HANDOFF_TOOLS=

# -- the control loop (ships inert: every goal in its charter is enabled: 0) ----
ARGUS_CYCLE_CRON=0 0 */6 * * *
ARGUS_JUDGE_PROVIDER=openai
ARGUS_JUDGE_BASE_URL=https://openrouter.ai/api/v1
ARGUS_JUDGE_MODEL=anthropic/claude-opus-4
ARGUS_MAX_LEDGER_ROWS=200000
ARGUS_MAX_NUMERIC_STEP_PCT=50
ARGUS_NUMERIC_PARAM_KEYS=temperature,max_tokens,external_timeout_ms,attachment_timeout_ms
ARGUS_PROBE_WINDOW_SEC=120
ARGUS_PROBE_MAX_ERRORS=0
ARGUS_PROBE_LEDGER_TRIES=3

# -- the capability broker ------------------------------------------------------
ACCESS_MAX_TTL_MS=86400000
ACCESS_POLICY_ROWS=200
ACCESS_SWEEP_CRON=0 */5 * * * *
ACCESS_SWEEP_ROWS=200
ACCESS_SWEEP_EVENT_ROWS=2000
ACCESS_USAGE_ROWS=500

# -- the vault inside the broker (both name a row and a source, never a key) ----
VAULT_KEY_SOURCE=auto
VAULT_CREDENTIAL_NAME=vault_key
