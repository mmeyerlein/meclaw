{
  "scope": "/",
  "ctx": {
    "model": "${MODEL_BRAIN}"
  },
  "diff": {
    "add_nodes": [
      {
        "name": "surface",
        "template": "door"
      },
      {
        "name": "firewall",
        "template": "firewall"
      },
      {
        "name": "talky",
        "template": "talky"
      },
      {
        "name": "drain",
        "template": "memory-drain"
      },
      {
        "name": "sink",
        "template": "terminal"
      }
    ],
    "add_edges": [
      {
        "from": "./surface",
        "to": "./firewall",
        "condition": "has(hop.route) && hop.route == 'turn'",
        "modifier": {
          "set_hop": {
            "route": "'in_turn'"
          },
          "set_context": {
            "channel": "hop.chat_id",
            "audience_set": "'[\"member:alex\",\"agent:scribe\"]'"
          }
        }
      },
      {
        "from": "./firewall",
        "to": "./talky",
        "condition": "has(hop.route) && hop.route == 'pass'",
        "modifier": {
          "set_hop": {
            "route": "'in_turn'"
          },
          "delete_context": [
            "fw_body",
            "fw_now",
            "fw_phase",
            "store_origin"
          ]
        }
      },
      {
        "from": "./firewall",
        "to": "./sink",
        "condition": "has(hop.route) && hop.route == 'reject'",
        "modifier": {
          "delete_context": [
            "fw_body",
            "fw_now",
            "fw_phase",
            "store_origin"
          ]
        }
      },
      {
        "from": "./talky",
        "to": "./sink",
        "condition": "has(hop.route) && hop.route == 'answer'"
      },
      {
        "from": "./talky",
        "to": "./drain",
        "condition": "has(hop.route) && hop.route == 'write'",
        "modifier": {
          "set_hop": {
            "route": "'in_batch'"
          },
          "set_context": {
            "session_id": "hop.session_id"
          }
        }
      },
      {
        "from": "./talky",
        "to": "./sink",
        "condition": "has(hop.route) && hop.route == 'error'"
      },
      {
        "from": "./drain",
        "to": "./sink",
        "condition": "has(hop.route) && hop.route == 'episode'",
        "modifier": {
          "set_context": {
            "session_id": "hop.session_id",
            "turn_id": "hop.turn_id",
            "happened_at": "hop.happened_at"
          }
        }
      },
      {
        "from": "./drain",
        "to": "./sink",
        "condition": "has(hop.route) && hop.route == 'reject'"
      }
    ]
  }
}
