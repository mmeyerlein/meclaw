{
  "scope": "/",
  "ctx": {
    "model": "${MODEL_BRAIN}"
  },
  "diff": {
    "add_nodes": [
      {
        "name": "door",
        "template": "door"
      },
      {
        "name": "firewall",
        "template": "firewall"
      },
      {
        "name": "talky",
        "template": "talky",
        "override_params": {
          "brain": {
            "credential_grant_id": "grant:openrouter@colony-example/talky-brain"
          },
          "curator/summarizer": {
            "credential_grant_id": "grant:openrouter@colony-example/talky-curator-summarizer"
          }
        }
      },
      {
        "name": "access",
        "template": "access"
      },
      {
        "name": "sink",
        "template": "terminal"
      }
    ],
    "add_edges": [
      {
        "from": "./door",
        "to": "./firewall",
        "condition": "has(hop.route) && hop.route == 'turn' && has(hop.chat_id) && hop.chat_id != 'operator'",
        "modifier": {
          "set_hop": {
            "route": "'in_turn'"
          },
          "set_context": {
            "channel": "hop.chat_id",
            "audience_set": "'[\"member:alex\",\"agent:scribe\"]'"
          }
        }
      },
      {
        "from": "./firewall",
        "to": "./talky",
        "condition": "has(hop.route) && hop.route == 'pass'",
        "modifier": {
          "set_hop": {
            "route": "'in_turn'"
          },
          "delete_context": [
            "fw_body",
            "fw_now",
            "fw_phase",
            "store_origin"
          ]
        }
      },
      {
        "from": "./talky",
        "to": "./sink",
        "condition": "has(hop.route) && hop.route == 'answer'"
      },
      {
        "from": "./talky",
        "to": "./sink",
        "condition": "has(hop.route) && hop.route == 'turn_write'"
      },
      {
        "from": "./talky/brain",
        "to": "./access",
        "lane": "credential_request",
        "condition": "has(hop.route) && hop.route == 'credential_request'",
        "modifier": {
          "set_hop": {
            "route": "'in_invoke'"
          },
          "set_context": {
            "requester": "'agent:talky/brain'"
          }
        }
      },
      {
        "from": "./access",
        "to": "./talky/brain",
        "lane": "in_sealed",
        "condition": "has(hop.route) && hop.route == 'ack' && has(hop.operation) && hop.operation == 'vault.deliver' && has(hop.grant_id) && hop.grant_id == 'grant:openrouter@colony-example/talky-brain'",
        "modifier": {
          "set_hop": {
            "route": "'in_sealed'"
          }
        }
      },
      {
        "from": "./talky/curator/summarizer",
        "to": "./access",
        "lane": "credential_request",
        "condition": "has(hop.route) && hop.route == 'credential_request'",
        "modifier": {
          "set_hop": {
            "route": "'in_invoke'"
          },
          "set_context": {
            "requester": "'agent:talky/curator/summarizer'"
          }
        }
      },
      {
        "from": "./access",
        "to": "./talky/curator/summarizer",
        "lane": "in_sealed",
        "condition": "has(hop.route) && hop.route == 'ack' && has(hop.operation) && hop.operation == 'vault.deliver' && has(hop.grant_id) && hop.grant_id == 'grant:openrouter@colony-example/talky-curator-summarizer'",
        "modifier": {
          "set_hop": {
            "route": "'in_sealed'"
          }
        }
      },
      {
        "from": "./access",
        "to": "./sink",
        "condition": "has(hop.route) && hop.route == 'ack' && (!has(hop.operation) || hop.operation != 'vault.deliver')"
      },
      {
        "from": "./access",
        "to": "./sink",
        "condition": "has(hop.route) && hop.route == 'grant'"
      },
      {
        "from": "./access",
        "to": "./sink",
        "condition": "has(hop.route) && hop.route == 'connect'"
      }
    ]
  }
}
