{
  "cell": {
    "type": "llm"
  },
  "params": {
    "provider": "openai",
    "model": "openai/gpt-4o-mini",
    "requirement": "Answers a greeting in one or two short sentences. Any small, fast and inexpensive chat model will do: there is no tool use and almost no context.",
    "api_key": "",
    "credential_grant_id": "grant:openrouter@colony-example/responder",
    "base_url": "https://openrouter.ai/api/v1",
    "temperature": 0.3
  },
  "contract": {
    "version": "1.0.0",
    "settings": {},
    "consumes": {
      "body": {
        "messages": {
          "type": "array",
          "required": true
        },
        "system": {
          "type": "object",
          "required": false
        },
        "sealed": {
          "type": "object",
          "required": false
        }
      }
    },
    "emits": {
      "hop": {
        "route": {
          "type": "string",
          "values": [
            "credential_request"
          ],
          "required": false
        },
        "grant_id": {
          "type": "string",
          "required": false
        }
      }
    }
  }
}
