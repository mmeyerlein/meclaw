{
  "cell": {
    "type": "llm"
  },
  "params": {
    "provider": "openai",
    "model": "openai/gpt-4o-mini",
    "requirement": "The thinking step of a small tool loop: it either calls one of two tools or gives the final answer in a few hundred tokens. It needs dependable tool calling over a short context, and it should be fast and inexpensive.",
    "api_key": "${OPENROUTER_API_KEY}",
    "base_url": "https://openrouter.ai/api/v1",
    "temperature": 0.2,
    "max_tokens": 512,
    "system_order": [
      "identity"
    ],
    "provider_extra": {
      "parallel_tool_calls": false
    }
  },
  "contract": {
    "version": "1.0.0",
    "settings": {},
    "consumes": {
      "body": {
        "messages": {
          "type": "array",
          "required": true
        },
        "system": {
          "type": "object",
          "required": false
        }
      }
    }
  }
}
