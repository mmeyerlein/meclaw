# meclaw example environment.
# Copy to `.env` (repo root) or into an example dir (e.g. examples/telegram-research/.env)
# and pass with `--env <path>`. Never commit a real `.env`; it is gitignored.

# --- LLM provider (required by the hello, swarm, and telegram-research examples) ---
# meclaw's `llm` cell speaks the OpenAI wire format. Any OpenAI-compatible
# endpoint works via OPENROUTER_BASE_URL (OpenRouter, a local server, etc.).
OPENROUTER_API_KEY=sk-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Telegram bridge (required by the telegram-research example only) ---
# Create a bot via @BotFather and paste its token here.
TELEGRAM_BOT_TOKEN=123456789:AA-your-bot-token-here

# --- Web search (telegram-research example) ---
# SearXNG-style JSON search endpoint. SEARCH_API_KEY is optional and may be
# left empty for an unauthenticated local SearXNG instance.
SEARCH_ENDPOINT=http://127.0.0.1:8888/search?format=json
SEARCH_API_KEY=

# Local, self-hosted OpenAI-compatible endpoint (llama.cpp / vLLM / ollama).
# Used by the builder hive's authoring cells so a build costs nothing.
LOCAL_LLM_BASE_URL=http://<host>:<port>/v1
LOCAL_LLM_API_KEY=<token-or-placeholder>
MODEL_BUILDER=<model-id-as-the-endpoint-reports-it>
BUILDER_LIBRARIAN_TOPK=5

# Slack — two bot identities for the slack-agent template (P12).
# Each bot is its own Slack app: the app-level token (xapp-) opens the Socket
# Mode connection, the bot token (xoxb-) IS that bot's identity in the
# workspace. Never share one app between two bots.
# Name the pair after each bot, e.g. SLACK_<BOTNAME>_APP_TOKEN.
SLACK_BOT_A_APP_TOKEN=xapp-1-A00000000-0000000000000-your-app-level-token
SLACK_BOT_A_BOT_TOKEN=xoxb-0000000000-0000000000000-your-bot-token
SLACK_BOT_B_APP_TOKEN=xapp-1-A00000000-0000000000000-your-app-level-token
SLACK_BOT_B_BOT_TOKEN=xoxb-0000000000-0000000000000-your-bot-token
# Channel both bots are invited to, for the live check.
SLACK_TEST_CHANNEL_ID=C00000000
