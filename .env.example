# meclaw example environment.
#
# This file is the copy template for a colony's `.env`: every variable the
# examples and the shipped templates in this repository need in order to boot,
# and nothing that only a private tree reads. Copy it to `.env` (repo root) or
# into a colony root (e.g. `examples/telegram-research/.env`) and pass it with
# `--env <path>`. Never commit a real `.env`; it is gitignored.
#
# A `${VAR}` without a default that is missing at boot is a hard failure — the
# daemon refuses to start and names the variable. That is deliberate: a colony
# silently running on a placeholder key is worse than a colony that does not
# run. Optional knobs are documented per template in `templates/<name>/README.md`
# and are an experimental surface (see `templates/README.md` § Env knobs).

# --- LLM provider (required by every example that talks to a model) ---
# meclaw's `llm` cell speaks the OpenAI wire format. Any OpenAI-compatible
# endpoint works via OPENROUTER_BASE_URL (OpenRouter, a local server, etc.).
OPENROUTER_API_KEY=sk-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Model ids (the examples name their tiers, they do not guess them) ---
# `hello` and `swarm` name their model inline; these three are read by the
# `never-forgets` and `meclaw-os` examples. Use the id your provider reports.
MODEL_BRAIN=openai/gpt-4o-mini
MODEL_CORE=openai/gpt-4o
MODEL_CORE_FAST=openai/gpt-4o-mini

# --- Telegram bridge (the telegram-research and bot-basic surfaces) ---
# Create a bot via @BotFather and paste its token here.
TELEGRAM_BOT_TOKEN=123456789:AA-your-bot-token-here

# --- Web search (telegram-research, research-assistant) ---
# SearXNG-style JSON search endpoint. SEARCH_API_KEY is optional and may be
# left empty for an unauthenticated local SearXNG instance.
SEARCH_ENDPOINT=http://127.0.0.1:8888/search?format=json
SEARCH_API_KEY=

# --- memory-hive (only if you instantiate `memory-hive@1.3.0`) ---
# Four of these have no default and the instantiation rejects without them: a
# model id has no defensible default, and picking one silently is how a memory
# lane ends up on a weak model without anyone deciding it.
MODEL_EXTRACTOR=openai/gpt-4o-mini
MODEL_DREAMER=openai/gpt-4o-mini
MODEL_DIALECTIC=openai/gpt-4o
# MODEL_JUDGE ships a top-tier placeholder default so the nightly round cannot
# fail silently — set it anyway, to the strongest model you have.
MODEL_JUDGE=anthropic/claude-opus-5
# Everything else the hive reads (batching, budgets, the embedding lane, the
# dream schedule) has a default; the table in templates/memory-hive/README.md
# is the reference.
